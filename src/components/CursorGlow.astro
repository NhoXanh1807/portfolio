---
// Cursor Glow Effect Component (Desktop only)
---

<div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>

<style>
  .cursor-glow {
    position: fixed;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    background:
      radial-gradient(
        circle,
        rgba(99, 102, 241, 0.15),
        rgba(139, 92, 246, 0.1),
        transparent 70%
      );
    transition: opacity 0.3s ease;
    mix-blend-mode: normal;
    transform: translate(-50%, -50%);
    filter: blur(20px);
    will-change: transform, opacity;
  }


  @media (max-width: 1024px) {
    .cursor-glow {
      display: none;
    }
  }

  @media (hover: none) {
    .cursor-glow {
      display: none;
    }
  }

  html[data-theme="dark"] .cursor-glow {
    filter: blur(25px);
    background:
      radial-gradient(
        circle,
        rgba(99, 102, 241, 0.2),
        rgba(139, 92, 246, 0.15),
        transparent 70%
      );
  }
</style>

<script>
  const cursorGlow = document.getElementById('cursor-glow');

  if (cursorGlow && window.matchMedia('(min-width: 1025px)').matches && window.matchMedia('(hover: hover)').matches) {
    let mouseX = 0;
    let mouseY = 0;
    let glowX = 0;
    let glowY = 0;

    // Track mouse position
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      cursorGlow.style.opacity = '1';
    });

    // Hide glow when mouse leaves window
    document.addEventListener('mouseleave', () => {
      cursorGlow.style.opacity = '0';
    });

    // Optimized animation loop with throttling
    let rafId;
    let lastTime = 0;
    const throttle = 16; // ~60fps

    function animate(currentTime) {
      if (currentTime - lastTime >= throttle) {
        // Smooth interpolation for glow position
        const dx = mouseX - glowX;
        const dy = mouseY - glowY;

        glowX += dx * 0.12;
        glowY += dy * 0.12;

        cursorGlow.style.left = `${glowX}px`;
        cursorGlow.style.top = `${glowY}px`;

        lastTime = currentTime;
      }

      rafId = requestAnimationFrame(animate);
    }

    animate(0);

    // Pause animation when tab is not visible
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        if (rafId) cancelAnimationFrame(rafId);
      } else {
        animate(0);
      }
    });
  }
</script>


def xor_decrypt(hex_data, key):
    """XOR decrypt hex data with a key string and return bytes"""
    # Convert hex string to byte array
    hex_bytes = bytes.fromhex(hex_data)
    
    # Convert key to byte array
    key_bytes = key.encode('utf-8')
    
    # XOR operation
    result = bytearray()
    for i in range(len(hex_bytes)):
        result.append(hex_bytes[i] ^ key_bytes[i % len(key_bytes)])
    
    return bytes(result)


def main():
    """Main function to decrypt and save as .exe file"""
    key = 'tungtungtung'
    data = ''
    
    print("=" * 60)
    print("XOR DECRYPTOR - Save as EXE")
    print("=" * 60)
    print(f"\nKey: {key}")
    print(f"Encrypted data length: {len(data)} hex characters ({len(data)//2} bytes)")
    
    # Decrypt the data
    print("\n[*] Decrypting data with XOR...")
    decrypted_bytes = xor_decrypt(data, key)
    
    # Check for MZ header (PE executable signature)
    if len(decrypted_bytes) >= 2:
        if decrypted_bytes[0] == 0x4D and decrypted_bytes[1] == 0x5A:  # 'MZ'
            print("✅ MZ header detected! This is a PE executable file.")
        else:
            print(f"⚠️  Warning: First bytes are {decrypted_bytes[0]:02X} {decrypted_bytes[1]:02X}, not MZ header")
            print("    (Expected: 4D 5A for PE executable)")
    
    # Display first 64 bytes in hex
    print("\n[*] First 64 bytes of decrypted data (hex):")
    print("-" * 60)
    for i in range(0, min(64, len(decrypted_bytes)), 16):
        hex_str = ' '.join(f'{b:02X}' for b in decrypted_bytes[i:i+16])
        ascii_str = ''.join(chr(b) if 32 <= b <= 126 else '.' for b in decrypted_bytes[i:i+16])
        print(f"{i:04X}: {hex_str:<48} {ascii_str}")
    print("-" * 60)
    
    # Save to .exe file
    output_filename = 'decrypted_output.exe'
    print(f"\n[*] Saving decrypted data to: {output_filename}")
    
    with open(output_filename, 'wb') as f:
        f.write(decrypted_bytes)
    
    print(f"✅ Successfully saved {len(decrypted_bytes)} bytes to {output_filename}")
    print(f"\n[*] You can now analyze this file with dnSpy or other PE analysis tools")
    print("=" * 60)


if __name__ == "__main__":
    try:
        main()
        input("\nPress Enter to exit...")
        
    except Exception as e:
        print(f"\n❌ Error: {str(e)}")
        import traceback
        traceback.print_exc()
        input("\nPress Enter to exit...")
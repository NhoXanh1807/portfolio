---
// Welcome Splash Screen Component - Cute & Cool Edition
---

<div id="welcome-splash" class="welcome-splash">
  <div class="splash-content">
    <div class="splash-logo">
      <div class="logo-circle">
        <!-- Sparkle & Star Icon -->
        <svg viewBox="0 0 100 100" class="sparkle-icon">
          <!-- Main Star -->
          <path
            d="M50 15 L55 40 L80 45 L60 60 L65 85 L50 72 L35 85 L40 60 L20 45 L45 40 Z"
            fill="currentColor"
            class="star-main"
          />
          <!-- Small sparkles -->
          <circle cx="25" cy="25" r="3" fill="currentColor" class="sparkle sparkle-1" />
          <circle cx="75" cy="25" r="3" fill="currentColor" class="sparkle sparkle-2" />
          <circle cx="25" cy="75" r="3" fill="currentColor" class="sparkle sparkle-3" />
          <circle cx="75" cy="75" r="3" fill="currentColor" class="sparkle sparkle-4" />
          <!-- Hearts -->
          <path
            d="M15 50 Q15 45 18 45 Q21 45 21 48 Q21 45 24 45 Q27 45 27 50 Q27 55 21 58 Q15 55 15 50"
            fill="currentColor"
            class="heart heart-1"
          />
          <path
            d="M73 30 Q73 27 75 27 Q77 27 77 29 Q77 27 79 27 Q81 27 81 30 Q81 33 77 35 Q73 33 73 30"
            fill="currentColor"
            class="heart heart-2"
          />
        </svg>
      </div>
    </div>
    <h1 class="splash-title">
      <span class="splash-letter">W</span>
      <span class="splash-letter">e</span>
      <span class="splash-letter">l</span>
      <span class="splash-letter">c</span>
      <span class="splash-letter">o</span>
      <span class="splash-letter">m</span>
      <span class="splash-letter">e</span>
    </h1>
    <p class="splash-subtitle">Let's Create Something Amazing ✨</p>
    <div class="loading-bar">
      <div class="loading-progress"></div>
    </div>
  </div>

  <!-- Floating Particles with Multiple Colors -->
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 30 }).map((_, i) => (
      <div class={`particle particle-${(i % 5) + 1}`}></div>
    ))}
  </div>

  <!-- Confetti -->
  <div class="confetti" aria-hidden="true">
    {Array.from({ length: 50 }).map((_, i) => (
      <div class={`confetti-piece confetti-${(i % 4) + 1}`}></div>
    ))}
  </div>

  <!-- Ripple Effects -->
  <div class="ripples" aria-hidden="true">
    <div class="ripple ripple-1"></div>
    <div class="ripple ripple-2"></div>
    <div class="ripple ripple-3"></div>
  </div>
</div>

<style>
  .welcome-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background:
      linear-gradient(
        135deg,
        rgba(251, 113, 133, 0.92),
        rgba(167, 139, 250, 0.95),
        rgba(59, 130, 246, 0.92),
        rgba(34, 211, 238, 0.9)
      );
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation:
      splashFadeOut 0.8s ease-in-out 3s forwards,
      gradientShift 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes splashFadeOut {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  @keyframes gradientShift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .splash-content {
    text-align: center;
    color: white;
    position: relative;
    z-index: 2;
    animation: contentSlideUp 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes contentSlideUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .splash-logo {
    margin-bottom: 2rem;
    animation: logoReveal 1.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes logoReveal {
    0% {
      opacity: 0;
      transform: scale(0.3) rotate(-180deg);
    }
    60% {
      transform: scale(1.15) rotate(10deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .logo-circle {
    width: 140px;
    height: 140px;
    margin: 0 auto;
    background:
      radial-gradient(
        circle at 30% 30%,
        rgba(255, 255, 255, 0.4),
        rgba(255, 255, 255, 0.1)
      );
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 60px rgba(251, 113, 133, 0.6),
      0 0 120px rgba(167, 139, 250, 0.5),
      inset 0 0 40px rgba(255, 255, 255, 0.2);
    position: relative;
    animation: logoPulse 2s ease-in-out infinite;
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 255, 255, 0.3);
  }

  @keyframes logoPulse {
    0%, 100% {
      box-shadow:
        0 0 60px rgba(251, 113, 133, 0.6),
        0 0 120px rgba(167, 139, 250, 0.5),
        inset 0 0 40px rgba(255, 255, 255, 0.2);
      transform: scale(1) rotate(0deg);
    }
    33% {
      box-shadow:
        0 0 80px rgba(167, 139, 250, 0.8),
        0 0 160px rgba(59, 130, 246, 0.6),
        inset 0 0 60px rgba(255, 255, 255, 0.3);
      transform: scale(1.08) rotate(5deg);
    }
    66% {
      box-shadow:
        0 0 70px rgba(59, 130, 246, 0.7),
        0 0 140px rgba(34, 211, 238, 0.5),
        inset 0 0 50px rgba(255, 255, 255, 0.25);
      transform: scale(1.05) rotate(-5deg);
    }
  }

  .sparkle-icon {
    width: 70px;
    height: 70px;
    color: white;
    filter: drop-shadow(0 0 10px rgba(255, 255, 255, 0.8));
  }

  .star-main {
    animation: starSpin 3s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes starSpin {
    0%, 100% {
      transform: rotate(0deg) scale(1);
      opacity: 1;
    }
    50% {
      transform: rotate(180deg) scale(1.1);
      opacity: 0.9;
    }
  }

  .sparkle {
    animation: sparkleShine 1.5s ease-in-out infinite;
    transform-origin: center;
  }

  .sparkle-1 { animation-delay: 0s; }
  .sparkle-2 { animation-delay: 0.3s; }
  .sparkle-3 { animation-delay: 0.6s; }
  .sparkle-4 { animation-delay: 0.9s; }

  @keyframes sparkleShine {
    0%, 100% {
      transform: scale(1);
      opacity: 0.8;
    }
    50% {
      transform: scale(1.8);
      opacity: 1;
    }
  }

  .heart {
    animation: heartBeat 1.2s ease-in-out infinite;
    transform-origin: center;
  }

  .heart-1 { animation-delay: 0s; }
  .heart-2 { animation-delay: 0.6s; }

  @keyframes heartBeat {
    0%, 100% {
      transform: scale(1);
    }
    25%, 75% {
      transform: scale(1.3);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .splash-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    margin: 0 0 1rem 0;
    letter-spacing: 0.05em;
    display: flex;
    justify-content: center;
    gap: 0.1em;
    background: linear-gradient(
      90deg,
      #ff6b9d,
      #c084fc,
      #60a5fa,
      #34d399,
      #fbbf24,
      #ff6b9d
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: rainbowFlow 3s linear infinite;
  }

  @keyframes rainbowFlow {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .splash-letter {
    display: inline-block;
    opacity: 0;
    animation: letterBounce 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .splash-letter:nth-child(1) { animation-delay: 0.1s; }
  .splash-letter:nth-child(2) { animation-delay: 0.2s; }
  .splash-letter:nth-child(3) { animation-delay: 0.3s; }
  .splash-letter:nth-child(4) { animation-delay: 0.4s; }
  .splash-letter:nth-child(5) { animation-delay: 0.5s; }
  .splash-letter:nth-child(6) { animation-delay: 0.6s; }
  .splash-letter:nth-child(7) { animation-delay: 0.7s; }

  @keyframes letterBounce {
    0% {
      opacity: 0;
      transform: translateY(-100px) rotate(-45deg) scale(0);
    }
    50% {
      transform: translateY(20px) rotate(10deg) scale(1.2);
    }
    70% {
      transform: translateY(-10px) rotate(-5deg) scale(0.9);
    }
    85% {
      transform: translateY(5px) rotate(2deg) scale(1.05);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(0deg) scale(1);
    }
  }

  .splash-subtitle {
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 600;
    margin: 0 0 2.5rem 0;
    opacity: 0;
    letter-spacing: 0.08em;
    color: white;
    text-shadow:
      0 0 20px rgba(255, 255, 255, 0.8),
      0 0 40px rgba(251, 113, 133, 0.6);
    animation: subtitleFloat 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.9s forwards;
  }

  @keyframes subtitleFloat {
    0% {
      opacity: 0;
      transform: translateY(30px) scale(0.8);
    }
    60% {
      transform: translateY(-10px) scale(1.05);
    }
    100% {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .loading-bar {
    width: clamp(200px, 60vw, 400px);
    height: 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    overflow: hidden;
    margin: 0 auto;
    opacity: 0;
    animation: loadingBarFade 0.5s ease-out 1.2s forwards;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }

  @keyframes loadingBarFade {
    to {
      opacity: 1;
    }
  }

  .loading-progress {
    height: 100%;
    background: linear-gradient(
      90deg,
      #ff6b9d,
      #c084fc,
      #60a5fa,
      #34d399,
      #fbbf24,
      #ff6b9d
    );
    background-size: 200% 100%;
    border-radius: 999px;
    animation:
      loadingProgress 2.5s ease-in-out 1.2s forwards,
      rainbowSlide 1.5s linear infinite;
    width: 0;
    box-shadow:
      0 0 30px rgba(251, 113, 133, 0.8),
      0 0 60px rgba(167, 139, 250, 0.6);
  }

  @keyframes loadingProgress {
    to {
      width: 100%;
    }
  }

  @keyframes rainbowSlide {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  .particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    opacity: 0.7;
    animation: particleFloat 4s ease-in-out infinite;
    box-shadow: 0 0 10px currentColor;
  }

  .particle-1 { background: #ff6b9d; }
  .particle-2 { background: #c084fc; }
  .particle-3 { background: #60a5fa; }
  .particle-4 { background: #34d399; }
  .particle-5 { background: #fbbf24; }

  .particle:nth-child(1) { left: 5%; top: 15%; animation-delay: 0s; animation-duration: 3.5s; }
  .particle:nth-child(2) { left: 15%; top: 75%; animation-delay: 0.3s; animation-duration: 4s; }
  .particle:nth-child(3) { left: 25%; top: 35%; animation-delay: 0.6s; animation-duration: 3.8s; }
  .particle:nth-child(4) { left: 35%; top: 55%; animation-delay: 0.9s; animation-duration: 4.2s; }
  .particle:nth-child(5) { left: 45%; top: 25%; animation-delay: 1.2s; animation-duration: 3.6s; }
  .particle:nth-child(6) { left: 55%; top: 65%; animation-delay: 1.5s; animation-duration: 4s; }
  .particle:nth-child(7) { left: 65%; top: 45%; animation-delay: 1.8s; animation-duration: 3.7s; }
  .particle:nth-child(8) { left: 75%; top: 20%; animation-delay: 2.1s; animation-duration: 4.1s; }
  .particle:nth-child(9) { left: 85%; top: 70%; animation-delay: 2.4s; animation-duration: 3.9s; }
  .particle:nth-child(10) { left: 95%; top: 50%; animation-delay: 2.7s; animation-duration: 4s; }
  .particle:nth-child(11) { left: 10%; top: 10%; animation-delay: 0.2s; animation-duration: 3.5s; }
  .particle:nth-child(12) { left: 20%; top: 85%; animation-delay: 0.5s; animation-duration: 4.3s; }
  .particle:nth-child(13) { left: 30%; top: 40%; animation-delay: 0.8s; animation-duration: 3.6s; }
  .particle:nth-child(14) { left: 40%; top: 60%; animation-delay: 1.1s; animation-duration: 4.2s; }
  .particle:nth-child(15) { left: 50%; top: 30%; animation-delay: 1.4s; animation-duration: 3.8s; }
  .particle:nth-child(16) { left: 60%; top: 70%; animation-delay: 1.7s; animation-duration: 4s; }
  .particle:nth-child(17) { left: 70%; top: 50%; animation-delay: 2s; animation-duration: 3.7s; }
  .particle:nth-child(18) { left: 80%; top: 25%; animation-delay: 2.3s; animation-duration: 4.1s; }
  .particle:nth-child(19) { left: 90%; top: 75%; animation-delay: 2.6s; animation-duration: 3.9s; }
  .particle:nth-child(20) { left: 8%; top: 55%; animation-delay: 0.4s; animation-duration: 4s; }
  .particle:nth-child(21) { left: 18%; top: 18%; animation-delay: 0.7s; animation-duration: 3.6s; }
  .particle:nth-child(22) { left: 28%; top: 80%; animation-delay: 1s; animation-duration: 4.2s; }
  .particle:nth-child(23) { left: 38%; top: 42%; animation-delay: 1.3s; animation-duration: 3.8s; }
  .particle:nth-child(24) { left: 48%; top: 62%; animation-delay: 1.6s; animation-duration: 4s; }
  .particle:nth-child(25) { left: 58%; top: 32%; animation-delay: 1.9s; animation-duration: 3.7s; }
  .particle:nth-child(26) { left: 68%; top: 72%; animation-delay: 2.2s; animation-duration: 4.1s; }
  .particle:nth-child(27) { left: 78%; top: 52%; animation-delay: 2.5s; animation-duration: 3.9s; }
  .particle:nth-child(28) { left: 88%; top: 28%; animation-delay: 2.8s; animation-duration: 4s; }
  .particle:nth-child(29) { left: 12%; top: 68%; animation-delay: 0.6s; animation-duration: 3.5s; }
  .particle:nth-child(30) { left: 22%; top: 48%; animation-delay: 0.9s; animation-duration: 4.3s; }

  @keyframes particleFloat {
    0%, 100% {
      transform: translateY(0) translateX(0) scale(1) rotate(0deg);
      opacity: 0.7;
    }
    25% {
      transform: translateY(-40px) translateX(20px) scale(1.3) rotate(90deg);
      opacity: 1;
    }
    50% {
      transform: translateY(-80px) translateX(-15px) scale(0.8) rotate(180deg);
      opacity: 0.5;
    }
    75% {
      transform: translateY(-40px) translateX(25px) scale(1.2) rotate(270deg);
      opacity: 0.9;
    }
  }

  /* Confetti Effects */
  .confetti {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  .confetti-piece {
    position: absolute;
    width: 10px;
    height: 10px;
    top: -10%;
    opacity: 0;
    animation: confettiFall 3s linear infinite;
  }

  .confetti-1 {
    background: #ff6b9d;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%);
  }

  .confetti-2 {
    background: #c084fc;
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  .confetti-3 {
    background: #60a5fa;
    border-radius: 50%;
  }

  .confetti-4 {
    background: #34d399;
    clip-path: polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%);
  }

  .confetti-piece:nth-child(odd) {
    left: calc(var(--n) * 2%);
    animation-delay: calc(var(--n) * 0.1s);
  }

  .confetti-piece:nth-child(even) {
    left: calc(100% - var(--n) * 2%);
    animation-delay: calc(var(--n) * 0.15s);
  }

  @for $i from 1 through 50 {
    .confetti-piece:nth-child(#{$i}) {
      --n: #{$i};
      left: random(100) * 1%;
      animation-delay: random(3000) * 0.001s;
      animation-duration: (2 + random(20) * 0.1) * 1s;
    }
  }

  .confetti-piece:nth-child(1) { left: 5%; animation-delay: 0.1s; }
  .confetti-piece:nth-child(2) { left: 15%; animation-delay: 0.3s; }
  .confetti-piece:nth-child(3) { left: 25%; animation-delay: 0.5s; }
  .confetti-piece:nth-child(4) { left: 35%; animation-delay: 0.7s; }
  .confetti-piece:nth-child(5) { left: 45%; animation-delay: 0.9s; }
  .confetti-piece:nth-child(6) { left: 55%; animation-delay: 1.1s; }
  .confetti-piece:nth-child(7) { left: 65%; animation-delay: 1.3s; }
  .confetti-piece:nth-child(8) { left: 75%; animation-delay: 1.5s; }
  .confetti-piece:nth-child(9) { left: 85%; animation-delay: 1.7s; }
  .confetti-piece:nth-child(10) { left: 95%; animation-delay: 1.9s; }
  .confetti-piece:nth-child(11) { left: 10%; animation-delay: 0.2s; }
  .confetti-piece:nth-child(12) { left: 20%; animation-delay: 0.4s; }
  .confetti-piece:nth-child(13) { left: 30%; animation-delay: 0.6s; }
  .confetti-piece:nth-child(14) { left: 40%; animation-delay: 0.8s; }
  .confetti-piece:nth-child(15) { left: 50%; animation-delay: 1s; }
  .confetti-piece:nth-child(16) { left: 60%; animation-delay: 1.2s; }
  .confetti-piece:nth-child(17) { left: 70%; animation-delay: 1.4s; }
  .confetti-piece:nth-child(18) { left: 80%; animation-delay: 1.6s; }
  .confetti-piece:nth-child(19) { left: 90%; animation-delay: 1.8s; }
  .confetti-piece:nth-child(20) { left: 8%; animation-delay: 2s; }

  @keyframes confettiFall {
    0% {
      top: -10%;
      opacity: 0;
      transform: translateX(0) rotate(0deg);
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      top: 110%;
      opacity: 0;
      transform: translateX(calc(-50px + random(100) * 1px)) rotate(720deg);
    }
  }

  /* Ripple Effects */
  .ripples {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    pointer-events: none;
  }

  .ripple {
    position: absolute;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.3);
    opacity: 0;
    animation: rippleExpand 4s ease-out infinite;
  }

  .ripple-1 {
    width: 200px;
    height: 200px;
    top: 50%;
    left: 50%;
    margin: -100px 0 0 -100px;
    animation-delay: 0s;
    border-color: rgba(251, 113, 133, 0.4);
  }

  .ripple-2 {
    width: 300px;
    height: 300px;
    top: 50%;
    left: 50%;
    margin: -150px 0 0 -150px;
    animation-delay: 1.3s;
    border-color: rgba(167, 139, 250, 0.4);
  }

  .ripple-3 {
    width: 400px;
    height: 400px;
    top: 50%;
    left: 50%;
    margin: -200px 0 0 -200px;
    animation-delay: 2.6s;
    border-color: rgba(59, 130, 246, 0.4);
  }

  @keyframes rippleExpand {
    0% {
      transform: scale(0);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  @media (max-width: 720px) {
    .splash-title {
      font-size: 2.5rem;
    }

    .splash-subtitle {
      font-size: 0.9rem;
      letter-spacing: 0.15em;
    }

    .logo-circle {
      width: 100px;
      height: 100px;
    }

    .shield-icon {
      width: 50px;
      height: 50px;
    }

    .loading-bar {
      width: 80vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-splash,
    .splash-content,
    .splash-logo,
    .logo-circle,
    .shield-path,
    .check-path,
    .splash-letter,
    .splash-subtitle,
    .loading-bar,
    .loading-progress,
    .particle {
      animation: none !important;
    }

    .welcome-splash {
      display: none;
    }
  }
</style>

<script>
  // Remove splash screen after animation
  const splash = document.getElementById('welcome-splash');
  if (splash && !sessionStorage.getItem('splashShown')) {
    sessionStorage.setItem('splashShown', 'true');
    setTimeout(() => {
      splash.remove();
    }, 4000);
  } else if (splash) {
    // If already shown this session, hide immediately
    splash.remove();
  }
</script>

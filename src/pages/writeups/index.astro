---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../../consts";

const writeups = (await getCollection("writeups"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all unique tags and tools
const allTags = [...new Set(writeups.flatMap(w => w.data.tags || []))].sort();
const allTools = [...new Set(writeups.flatMap(w => w.data.tools || []))].sort();

const pageTitle = "Writeups | " + SITE_TITLE;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={pageTitle} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <header class="page-header" data-animate>
        <div class="page-heading">
          <h1>Writeups</h1>
        </div>
        <p>
          Every investigation note is written in Markdown and lives inside this.
        </p>
      </header>

      <!-- Filters Section -->
      <section class="filters" data-animate>
        <div class="filter-group">
          <label for="search-name">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <path d="m21 21-4.35-4.35"></path>
            </svg>
            Search Name
          </label>
          <input
            type="text"
            id="search-name"
            placeholder="Search writeups..."
            autocomplete="off"
          />
        </div>

        <div class="filter-group">
          <label for="filter-tag">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
              <line x1="7" y1="7" x2="7.01" y2="7"></line>
            </svg>
            Filter by Tag
          </label>
          <select id="filter-tag">
            <option value="">All Tags</option>
            {allTags.map(tag => <option value={tag}>{tag}</option>)}
          </select>
        </div>

        <div class="filter-group">
          <label for="filter-tool">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
            </svg>
            Filter by Tool
          </label>
          <select id="filter-tool">
            <option value="">All Tools</option>
            {allTools.map(tool => <option value={tool}>{tool}</option>)}
          </select>
        </div>

        <button id="reset-filters" class="reset-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path>
            <path d="M21 3v5h-5"></path>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path>
            <path d="M3 21v-5h5"></path>
          </svg>
          Reset
        </button>
      </section>

      <div class="results-info" id="results-info"></div>

      <section class="writeups-grid" id="writeups-grid" data-animate="stagger">
        {
          writeups.map((entry) => (
            <article class="card" data-writeup
              data-title={entry.data.title.toLowerCase()}
              data-tags={JSON.stringify(entry.data.tags || [])}
              data-tools={JSON.stringify(entry.data.tools || [])}>
              <span class="card-orbit" aria-hidden="true" />
              <span class="card-aurora" aria-hidden="true" />
              <a class="card-link" href={`/writeups/${entry.id}/`}>
                <div class="card-sheen" aria-hidden="true" />
                {entry.data.heroImage && (
                  <img
                    class="hero"
                    src={entry.data.heroImage}
                    alt={entry.data.title}
                    loading="lazy"
                  />
                )}
                <div class="meta">
                  <div class="meta-top">
                    <p class="posted">{entry.data.pubDate.toLocaleDateString()}</p>
                    {entry.data.updatedDate && (
                      <p class="updated">
                        Updated {entry.data.updatedDate.toLocaleDateString()}
                      </p>
                    )}
                  </div>
                  <div class="meta-heading">
                    <h2>{entry.data.title}</h2>
                    <p class="summary">{entry.data.summary}</p>
                  </div>
                  <div class="meta-footer">
                    {entry.data.tools.length > 0 && (
                      <ul class="tools" aria-label="Tooling">
                        {entry.data.tools.map((tool) => (
                          <li>{tool}</li>
                        ))}
                      </ul>
                    )}
                    {entry.data.tags.length > 0 && (
                      <ul class="tags" aria-label="Tags">
                        {entry.data.tags.map((tag) => (
                          <li>{tag}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              </a>
            </article>
          ))
        }
      </section>

      <!-- Pagination -->
      <nav class="pagination" id="pagination" aria-label="Pagination"></nav>
    </main>
    <Footer />

    <script>
      // Pagination and filtering logic
      const ITEMS_PER_PAGE = 5;
      let currentPage = 1;
      let filteredWriteups: HTMLElement[] = [];

      const searchInput = document.getElementById('search-name') as HTMLInputElement;
      const tagSelect = document.getElementById('filter-tag') as HTMLSelectElement;
      const toolSelect = document.getElementById('filter-tool') as HTMLSelectElement;
      const resetBtn = document.getElementById('reset-filters') as HTMLButtonElement;
      const resultsInfo = document.getElementById('results-info') as HTMLElement;
      const paginationContainer = document.getElementById('pagination') as HTMLElement;

      function getAllWriteups(): HTMLElement[] {
        return Array.from(document.querySelectorAll('[data-writeup]'));
      }

      function filterWriteups() {
        const searchTerm = searchInput.value.toLowerCase().trim();
        const selectedTag = tagSelect.value;
        const selectedTool = toolSelect.value;

        const allWriteups = getAllWriteups();

        filteredWriteups = allWriteups.filter((writeup) => {
          const title = writeup.getAttribute('data-title') || '';
          const tags = JSON.parse(writeup.getAttribute('data-tags') || '[]');
          const tools = JSON.parse(writeup.getAttribute('data-tools') || '[]');

          const matchesSearch = !searchTerm || title.includes(searchTerm);
          const matchesTag = !selectedTag || tags.includes(selectedTag);
          const matchesTool = !selectedTool || tools.includes(selectedTool);

          return matchesSearch && matchesTag && matchesTool;
        });

        currentPage = 1;
        updateDisplay();
      }

      function updateDisplay() {
        const allWriteups = getAllWriteups();
        const totalFiltered = filteredWriteups.length;
        const totalPages = Math.ceil(totalFiltered / ITEMS_PER_PAGE);
        const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
        const endIndex = startIndex + ITEMS_PER_PAGE;

        // Hide all writeups first
        allWriteups.forEach(writeup => {
          (writeup as HTMLElement).style.display = 'none';
        });

        // Show only paginated filtered writeups
        filteredWriteups.slice(startIndex, endIndex).forEach(writeup => {
          (writeup as HTMLElement).style.display = 'block';
        });

        // Update results info
        if (totalFiltered === 0) {
          resultsInfo.textContent = 'No writeups found matching your criteria.';
          resultsInfo.style.display = 'block';
        } else if (totalFiltered < allWriteups.length) {
          resultsInfo.textContent = `Showing ${totalFiltered} of ${allWriteups.length} writeups`;
          resultsInfo.style.display = 'block';
        } else {
          resultsInfo.style.display = 'none';
        }

        // Update pagination
        renderPagination(totalPages);
      }

      function renderPagination(totalPages: number) {
        if (totalPages <= 1) {
          paginationContainer.innerHTML = '';
          return;
        }

        let html = '<button class="page-btn" data-page="prev" ' + (currentPage === 1 ? 'disabled' : '') + '>Previous</button>';

        for (let i = 1; i <= totalPages; i++) {
          if (
            i === 1 ||
            i === totalPages ||
            (i >= currentPage - 1 && i <= currentPage + 1)
          ) {
            html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</button>`;
          } else if (i === currentPage - 2 || i === currentPage + 2) {
            html += '<span class="page-ellipsis">...</span>';
          }
        }

        html += '<button class="page-btn" data-page="next" ' + (currentPage === totalPages ? 'disabled' : '') + '>Next</button>';

        paginationContainer.innerHTML = html;

        // Add event listeners to pagination buttons
        paginationContainer.querySelectorAll('.page-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const target = e.target as HTMLButtonElement;
            const page = target.getAttribute('data-page');

            if (page === 'prev' && currentPage > 1) {
              currentPage--;
            } else if (page === 'next' && currentPage < totalPages) {
              currentPage++;
            } else if (page && !isNaN(Number(page))) {
              currentPage = Number(page);
            }

            updateDisplay();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });
      }

      function resetFilters() {
        searchInput.value = '';
        tagSelect.value = '';
        toolSelect.value = '';
        filterWriteups();
      }

      // Event listeners
      searchInput.addEventListener('input', filterWriteups);
      tagSelect.addEventListener('change', filterWriteups);
      toolSelect.addEventListener('change', filterWriteups);
      resetBtn.addEventListener('click', resetFilters);

      // Initialize
      filterWriteups();
    </script>
  </body>
</html>

<style>
  main {
    max-width: min(1220px, 100%);
    margin: 0 auto;
    padding: 4rem 1.5rem 5.5rem;
  }
  .page-header {
    margin-bottom: 3.5rem;
    display: grid;
    gap: 1.25rem;
    background: rgba(255, 255, 255, 0.85);
    border-radius: 1.5rem;
    padding: 2.25rem clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 30px 60px rgba(15, 23, 42, 0.12);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .page-header::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(14, 165, 233, 0.16),
      rgba(16, 185, 129, 0.18)
    );
    opacity: 0.7;
    z-index: -2;
    animation: headerRibbonDrift 22s ease-in-out infinite;
  }
  .page-header::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.75);
    z-index: -1;
  }
  .page-header p {
    max-width: 70ch;
    margin: 0;
  }
  .page-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }
  .page-heading h1 {
    font-size: clamp(2.4rem, 4vw, 3rem);
    margin: 0;
  }

  /* Filters Section */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 3rem;
    padding: 2rem clamp(1.5rem, 4vw, 2.5rem);
    background: rgba(255, 255, 255, 0.88);
    border-radius: 1.5rem;
    box-shadow: 0 20px 50px rgba(15, 23, 42, 0.1);
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .filters::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(14, 165, 233, 0.08),
      rgba(129, 140, 248, 0.1)
    );
    opacity: 0.8;
    z-index: -2;
  }
  .filters::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(255, 255, 255, 0.7);
    z-index: -1;
  }
  .filter-group {
    flex: 1;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .filter-group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: rgb(var(--gray-dark));
    letter-spacing: 0.01em;
  }
  .filter-group label svg {
    opacity: 0.75;
    flex-shrink: 0;
  }
  .filter-group input,
  .filter-group select {
    padding: 0.75rem 1rem;
    border: 1px solid rgba(var(--gray-light), 0.5);
    border-radius: 0.75rem;
    font-size: 0.95rem;
    background: rgba(255, 255, 255, 0.95);
    transition: all 0.3s ease;
    font-family: inherit;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }
  .filter-group input::placeholder {
    color: rgba(var(--gray), 0.5);
  }
  .filter-group input:focus,
  .filter-group select:focus {
    outline: none;
    border-color: rgba(var(--accent), 0.5);
    box-shadow: 0 0 0 4px rgba(var(--accent), 0.08), 0 4px 12px rgba(15, 23, 42, 0.08);
    background: white;
  }
  .filter-group select {
    cursor: pointer;
  }
  .reset-btn {
    align-self: flex-end;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: linear-gradient(135deg, rgba(var(--accent), 0.12), rgba(var(--accent), 0.08));
    color: var(--accent);
    border: 1px solid rgba(var(--accent), 0.2);
    border-radius: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    height: fit-content;
    margin-top: auto;
    box-shadow: 0 2px 8px rgba(var(--accent), 0.12);
  }
  .reset-btn:hover {
    background: linear-gradient(135deg, rgba(var(--accent), 0.18), rgba(var(--accent), 0.12));
    border-color: rgba(var(--accent), 0.35);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(var(--accent), 0.2);
  }
  .reset-btn:active {
    transform: translateY(0);
  }
  .reset-btn svg {
    width: 16px;
    height: 16px;
  }

  /* Results Info */
  .results-info {
    display: none;
    padding: 1rem 1.5rem;
    margin-bottom: 2rem;
    background: linear-gradient(135deg, rgba(var(--accent), 0.08), rgba(var(--accent), 0.05));
    border-left: 4px solid var(--accent);
    border-radius: 0.75rem;
    color: rgb(var(--gray-dark));
    font-weight: 500;
    box-shadow: 0 4px 12px rgba(var(--accent), 0.08);
  }

  /* Pagination */
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.65rem;
    margin-top: 3.5rem;
    flex-wrap: wrap;
  }
  .page-btn {
    padding: 0.7rem 1.1rem;
    border: 1px solid rgba(var(--gray-light), 0.5);
    background: rgba(255, 255, 255, 0.95);
    color: rgb(var(--gray-dark));
    border-radius: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 48px;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    font-family: inherit;
  }
  .page-btn:hover:not(:disabled) {
    background: rgba(var(--accent), 0.08);
    border-color: rgba(var(--accent), 0.3);
    transform: translateY(-3px);
    box-shadow: 0 6px 16px rgba(var(--accent), 0.15);
  }
  .page-btn.active {
    background: linear-gradient(135deg, var(--accent), rgba(var(--accent), 0.85));
    color: white;
    border-color: var(--accent);
    box-shadow: 0 6px 20px rgba(var(--accent), 0.35);
  }
  .page-btn.active:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(var(--accent), 0.4);
  }
  .page-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
    transform: none !important;
  }
  .page-btn:active:not(:disabled) {
    transform: translateY(-1px);
  }
  .page-ellipsis {
    padding: 0.7rem 0.5rem;
    color: rgba(var(--gray), 0.5);
    font-weight: 600;
  }

  .writeups-grid {
    display: grid;
    gap: 2.75rem;
    grid-template-columns: 1fr;
  }
  .card {
    --card-accent: 14 165 233;
    position: relative;
    border-radius: 1.5rem;
    overflow: hidden;
    padding: 1px;
    background: linear-gradient(
      135deg,
      rgba(var(--card-accent), 0.25),
      rgba(16, 185, 129, 0.2)
    );
    box-shadow: 0 34px 64px rgba(15, 23, 42, 0.16);
    transition:
      transform 0.4s ease,
      box-shadow 0.4s ease;
  }
  .card:nth-child(3n + 1) {
    --card-accent: 56 189 248;
  }
  .card:nth-child(3n + 2) {
    --card-accent: 244 114 182;
  }
  .card:nth-child(3n + 3) {
    --card-accent: 129 140 248;
  }
  .card-link {
    display: grid;
    grid-template-rows: auto 1fr;
    text-decoration: none;
    color: inherit;
    height: 100%;
    background: rgba(255, 255, 255, 0.92);
    border-radius: calc(1.5rem - 1px);
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .card-orbit,
  .card-aurora {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .card-orbit {
    border-radius: inherit;
    background: radial-gradient(
        circle at top right,
        rgba(var(--card-accent), 0.4),
        transparent 65%
      ),
      radial-gradient(
        circle at bottom left,
        rgba(16, 185, 129, 0.4),
        transparent 60%
      );
    filter: blur(0px);
    mix-blend-mode: screen;
    opacity: 0.9;
    animation: cardOrbit 24s ease-in-out infinite;
  }
  .card-aurora {
    border-radius: inherit;
    background: conic-gradient(
      from 120deg,
      rgba(255, 255, 255, 0.45),
      rgba(255, 255, 255, 0) 55%,
      rgba(255, 255, 255, 0.5)
    );
    transform: translate3d(-35%, -25%, 0) rotate(8deg);
    opacity: 0;
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }
  .card:hover,
  .card:focus-within {
    transform: translateY(-12px) scale(1.01);
    box-shadow: 0 48px 92px rgba(15, 23, 42, 0.24);
  }
  .card:hover .card-aurora,
  .card:focus-within .card-aurora {
    opacity: 0.9;
    transform: translate3d(0, 0, 0) rotate(0deg);
  }
  .hero {
    width: 100%;
    height: clamp(180px, 28vw, 230px);
    object-fit: cover;
    border-bottom: 1px solid rgba(var(--card-accent), 0.2);
  }
  .meta {
    padding: clamp(1.85rem, 4vw, 2.15rem) clamp(1.6rem, 4vw, 2rem)
      clamp(1.85rem, 4vw, 2.15rem);
    color: rgb(var(--gray-dark));
    display: grid;
    gap: 1.35rem;
  }
  .posted {
    margin: 0;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(var(--gray), 0.8);
  }
  .updated {
    margin: 0;
    font-size: 0.9rem;
    color: rgba(var(--accent), 0.9);
    font-weight: 600;
  }
  .meta-top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    align-items: baseline;
  }
  .meta-heading {
    display: grid;
    gap: 0.65rem;
  }
  .meta-heading h2 {
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 1.55rem);
    line-height: 1.3;
  }
  .summary {
    margin: 0;
    color: rgba(var(--gray-dark), 0.88);
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 4;
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 65ch;
  }
  .meta-footer {
    display: grid;
    gap: 0.85rem;
  }
  .tools,
  .tags {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tools li,
  .tags li {
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgba(var(--accent), 0.12);
    color: var(--accent);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    transition:
      transform 0.3s ease,
      background 0.3s ease;
  }
  .tags li {
    background: rgba(var(--gray-light), 0.45);
    color: rgb(var(--gray-dark));
  }
  .tools li:hover,
  .tags li:hover {
    transform: translateY(-2px);
    background: rgba(var(--card-accent), 0.22);
  }
  .card-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(255, 255, 255, 0) 20%,
      rgba(255, 255, 255, 0.35) 50%,
      rgba(255, 255, 255, 0) 80%
    );
    transform: translateX(-100%);
    transition: transform 0.8s ease;
    z-index: 1;
  }
  .card:hover .card-sheen {
    transform: translateX(120%);
  }
  .card-link:focus-visible {
    outline: 3px solid rgba(var(--card-accent), 0.65);
    outline-offset: 6px;
  }
  @keyframes cardOrbit {
    0%,
    100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    40% {
      transform: translate3d(10px, -12px, 0) scale(1.04);
    }
    70% {
      transform: translate3d(-14px, 10px, 0) scale(1.02);
    }
  }
  html[data-theme="dark"] .page-header {
    background: rgba(var(--surface-rgb), 0.92);
    box-shadow: 0 40px 80px rgba(2, 6, 23, 0.55);
  }
  html[data-theme="dark"] .page-header::before {
    opacity: 0.85;
    background: linear-gradient(
      120deg,
      rgba(56, 189, 248, 0.18),
      rgba(129, 140, 248, 0.22)
    );
  }
  html[data-theme="dark"] .page-header::after {
    background: rgba(var(--surface-rgb), 0.75);
  }
  html[data-theme="dark"] .page-header p {
    color: rgba(226, 232, 240, 0.88);
  }
  html[data-theme="dark"] .filters {
    background: rgba(var(--surface-rgb), 0.88);
    box-shadow: 0 20px 50px rgba(2, 6, 23, 0.6);

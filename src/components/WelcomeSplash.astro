---
// Welcome Splash Screen Component - Cool & Cute Version
---

<div id="welcome-splash" class="welcome-splash">
  <div class="splash-content">
    <div class="splash-logo">
      <div class="logo-circle">
        <div class="sparkle sparkle-1">✨</div>
        <div class="sparkle sparkle-2">⭐</div>
        <div class="sparkle sparkle-3">💫</div>
        <div class="sparkle sparkle-4">✨</div>
        <div class="heart-burst">
          <span class="heart">💖</span>
          <span class="heart">💗</span>
          <span class="heart">💝</span>
          <span class="heart">💓</span>
        </div>
        <div class="emoji-stack">
          <span class="emoji layer-1">🚀</span>
          <span class="emoji layer-2">🌟</span>
          <span class="emoji layer-3">✨</span>
        </div>
      </div>
    </div>
    <h1 class="splash-title">
      <span class="splash-letter gradient-text">W</span>
      <span class="splash-letter gradient-text">e</span>
      <span class="splash-letter gradient-text">l</span>
      <span class="splash-letter gradient-text">c</span>
      <span class="splash-letter gradient-text">o</span>
      <span class="splash-letter gradient-text">m</span>
      <span class="splash-letter gradient-text">e</span>
    </h1>
    <p class="splash-subtitle">
      <span class="subtitle-emoji">🎨</span>
      Let's Create Something Amazing
      <span class="subtitle-emoji">🎯</span>
    </p>
    <div class="loading-bar">
      <div class="loading-progress">
        <div class="loading-dot"></div>
        <div class="loading-dot"></div>
        <div class="loading-dot"></div>
      </div>
    </div>
  </div>
  <div class="floating-shapes" aria-hidden="true">
    <div class="shape circle"></div>
    <div class="shape square"></div>
    <div class="shape triangle"></div>
    <div class="shape star">⭐</div>
    <div class="shape heart">💜</div>
    <div class="shape rocket">🚀</div>
    <div class="shape circle small"></div>
    <div class="shape square small"></div>
  </div>
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 30 }).map(() => (
      <div class="particle"></div>
    ))}
  </div>
</div>

<style>
  .welcome-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(
      135deg,
      #667eea 0%,
      #764ba2 25%,
      #f093fb 50%,
      #4facfe 75%,
      #00f2fe 100%
    );
    background-size: 400% 400%;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation:
      gradientShift 8s ease infinite,
      splashFadeOut 0.8s ease-in-out 3s forwards;
    pointer-events: none;
  }

  @keyframes gradientShift {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  @keyframes splashFadeOut {
    to {
      opacity: 0;
      visibility: hidden;
      transform: scale(1.2);
    }
  }

  .splash-content {
    text-align: center;
    color: white;
    position: relative;
    z-index: 2;
    animation: contentBounceIn 1.2s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  @keyframes contentBounceIn {
    0% {
      opacity: 0;
      transform: scale(0.3) rotate(-15deg);
    }
    50% {
      transform: scale(1.1) rotate(5deg);
    }
    70% {
      transform: scale(0.95) rotate(-2deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .splash-logo {
    margin-bottom: 2rem;
    animation: logoFloat 3s ease-in-out infinite;
  }

  @keyframes logoFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    25% {
      transform: translateY(-15px) rotate(5deg);
    }
    75% {
      transform: translateY(-10px) rotate(-5deg);
    }
  }

  .logo-circle {
    width: 140px;
    height: 140px;
    margin: 0 auto;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.1));
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 60px rgba(255, 255, 255, 0.4),
      0 0 100px rgba(147, 51, 234, 0.3),
      inset 0 0 40px rgba(255, 255, 255, 0.2);
    position: relative;
    animation: logoRotate 10s linear infinite;
    border: 3px solid rgba(255, 255, 255, 0.5);
  }

  @keyframes logoRotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  .sparkle {
    position: absolute;
    font-size: 1.5rem;
    animation: sparkleFloat 2s ease-in-out infinite;
  }

  .sparkle-1 {
    top: -10px;
    left: 20px;
    animation-delay: 0s;
  }

  .sparkle-2 {
    top: 10px;
    right: 10px;
    animation-delay: 0.5s;
  }

  .sparkle-3 {
    bottom: 10px;
    left: 10px;
    animation-delay: 1s;
  }

  .sparkle-4 {
    bottom: -10px;
    right: 20px;
    animation-delay: 1.5s;
  }

  @keyframes sparkleFloat {
    0%, 100% {
      transform: translateY(0) scale(1) rotate(0deg);
      opacity: 1;
    }
    50% {
      transform: translateY(-20px) scale(1.3) rotate(180deg);
      opacity: 0.8;
    }
  }

  .heart-burst {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .heart {
    position: absolute;
    font-size: 1.2rem;
    animation: heartBurst 2s ease-out infinite;
  }

  .heart:nth-child(1) {
    animation-delay: 0s;
  }

  .heart:nth-child(2) {
    animation-delay: 0.5s;
  }

  .heart:nth-child(3) {
    animation-delay: 1s;
  }

  .heart:nth-child(4) {
    animation-delay: 1.5s;
  }

  @keyframes heartBurst {
    0% {
      transform: translate(0, 0) scale(0);
      opacity: 0;
    }
    20% {
      opacity: 1;
    }
    100% {
      transform: translate(var(--x, 50px), var(--y, -50px)) scale(1.5);
      opacity: 0;
    }
  }

  .heart:nth-child(1) {
    --x: 60px;
    --y: -60px;
  }

  .heart:nth-child(2) {
    --x: -60px;
    --y: -60px;
  }

  .heart:nth-child(3) {
    --x: 60px;
    --y: 60px;
  }

  .heart:nth-child(4) {
    --x: -60px;
    --y: 60px;
  }

  .emoji-stack {
    position: relative;
    width: 60px;
    height: 60px;
    margin: 0 auto;
  }

  .emoji {
    position: absolute;
    font-size: 3rem;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    animation: emojiPop 3s ease-in-out infinite;
  }

  .layer-1 {
    animation-delay: 0s;
  }

  .layer-2 {
    animation-delay: 1s;
  }

  .layer-3 {
    animation-delay: 2s;
  }

  @keyframes emojiPop {
    0%, 100% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
    }
    10%, 30% {
      transform: translate(-50%, -50%) scale(1.3);
      opacity: 1;
    }
    40% {
      transform: translate(-50%, -50%) scale(0);
      opacity: 0;
    }
  }

  .splash-title {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 900;
    margin: 0 0 1.5rem 0;
    letter-spacing: 0.08em;
    display: flex;
    justify-content: center;
    gap: 0.15em;
    filter: drop-shadow(0 4px 20px rgba(255, 255, 255, 0.5));
  }

  .gradient-text {
    background: linear-gradient(
      45deg,
      #fff,
      #ffd700,
      #fff,
      #00ffff,
      #fff,
      #ff00ff
    );
    background-size: 300% 300%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradientText 3s ease infinite;
  }

  @keyframes gradientText {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .splash-letter {
    display: inline-block;
    opacity: 0;
    animation: letterBounce 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
  }

  .splash-letter:nth-child(1) { animation-delay: 0.1s; }
  .splash-letter:nth-child(2) { animation-delay: 0.2s; }
  .splash-letter:nth-child(3) { animation-delay: 0.3s; }
  .splash-letter:nth-child(4) { animation-delay: 0.4s; }
  .splash-letter:nth-child(5) { animation-delay: 0.5s; }
  .splash-letter:nth-child(6) { animation-delay: 0.6s; }
  .splash-letter:nth-child(7) { animation-delay: 0.7s; }

  @keyframes letterBounce {
    0% {
      opacity: 0;
      transform: translateY(-100px) rotate(-45deg) scale(0);
    }
    60% {
      transform: translateY(10px) rotate(5deg) scale(1.2);
    }
    80% {
      transform: translateY(-5px) rotate(-2deg) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateY(0) rotate(0deg) scale(1);
    }
  }

  .splash-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 600;
    margin: 0 0 3rem 0;
    opacity: 0;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    animation: subtitleSlide 1s ease-out 0.8s forwards;
    filter: drop-shadow(0 2px 10px rgba(255, 255, 255, 0.3));
  }

  .subtitle-emoji {
    display: inline-block;
    animation: emojiWiggle 1s ease-in-out infinite;
    font-size: 1.4em;
    margin: 0 0.3em;
  }

  @keyframes emojiWiggle {
    0%, 100% {
      transform: rotate(-10deg) scale(1);
    }
    50% {
      transform: rotate(10deg) scale(1.2);
    }
  }

  @keyframes subtitleSlide {
    from {
      opacity: 0;
      transform: translateX(-50px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .loading-bar {
    width: clamp(220px, 70vw, 450px);
    height: 8px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    overflow: visible;
    margin: 0 auto;
    opacity: 0;
    animation: loadingBarFade 0.5s ease-out 1.3s forwards;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
  }

  @keyframes loadingBarFade {
    to {
      opacity: 1;
    }
  }

  .loading-progress {
    height: 100%;
    background: linear-gradient(
      90deg,
      #667eea,
      #764ba2,
      #f093fb,
      #4facfe,
      #00f2fe
    );
    background-size: 200% 100%;
    border-radius: 999px;
    animation:
      loadingProgress 2.5s ease-in-out 1.3s forwards,
      loadingShimmer 1.5s ease-in-out infinite;
    width: 0;
    box-shadow: 0 0 30px rgba(147, 51, 234, 0.8);
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 8px;
  }

  @keyframes loadingProgress {
    to {
      width: 100%;
    }
  }

  @keyframes loadingShimmer {
    0%, 100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  .loading-dot {
    width: 6px;
    height: 6px;
    background: white;
    border-radius: 50%;
    animation: dotBounce 1s ease-in-out infinite;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
  }

  .loading-dot:nth-child(2) {
    animation-delay: 0.2s;
  }

  .loading-dot:nth-child(3) {
    animation-delay: 0.4s;
  }

  @keyframes dotBounce {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.5);
    }
  }

  .floating-shapes {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .shape {
    position: absolute;
    opacity: 0.7;
    animation: shapeFloat 6s ease-in-out infinite;
  }

  .circle {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #667eea, #764ba2);
    border-radius: 50%;
    top: 20%;
    left: 10%;
  }

  .circle.small {
    width: 30px;
    height: 30px;
    background: linear-gradient(135deg, #f093fb, #4facfe);
    top: 70%;
    left: 85%;
    animation-delay: 1s;
  }

  .square {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, #f093fb, #f5576c);
    border-radius: 10px;
    top: 60%;
    left: 15%;
    animation-delay: 0.5s;
  }

  .square.small {
    width: 35px;
    height: 35px;
    background: linear-gradient(135deg, #4facfe, #00f2fe);
    top: 15%;
    left: 80%;
    animation-delay: 1.5s;
  }

  .triangle {
    width: 0;
    height: 0;
    border-left: 30px solid transparent;
    border-right: 30px solid transparent;
    border-bottom: 50px solid #ffd700;
    top: 80%;
    left: 75%;
    animation-delay: 1s;
  }

  .star, .heart, .rocket {
    font-size: 3rem;
    animation: shapeFloat 5s ease-in-out infinite;
  }

  .star {
    top: 25%;
    left: 85%;
    animation-delay: 0.3s;
  }

  .heart {
    top: 70%;
    left: 80%;
    animation-delay: 0.8s;
  }

  .rocket {
    top: 40%;
    left: 8%;
    animation-delay: 1.2s;
  }

  @keyframes shapeFloat {
    0%, 100% {
      transform: translateY(0) rotate(0deg);
    }
    25% {
      transform: translateY(-30px) rotate(90deg);
    }
    75% {
      transform: translateY(-20px) rotate(-90deg);
    }
  }

  .particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    background: white;
    border-radius: 50%;
    opacity: 0.8;
    animation: particleRise 4s ease-in-out infinite;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
  }

  .particle:nth-child(odd) {
    background: #ffd700;
  }

  .particle:nth-child(3n) {
    background: #00ffff;
  }

  .particle:nth-child(5n) {
    background: #ff00ff;
  }

  @keyframes particleRise {
    0% {
      transform: translateY(100vh) scale(0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      transform: translateY(-100px) scale(1);
      opacity: 0;
    }
  }

  .particle:nth-child(1) { left: 5%; animation-delay: 0s; }
  .particle:nth-child(2) { left: 10%; animation-delay: 0.3s; }
  .particle:nth-child(3) { left: 15%; animation-delay: 0.6s; }
  .particle:nth-child(4) { left: 20%; animation-delay: 0.9s; }
  .particle:nth-child(5) { left: 25%; animation-delay: 1.2s; }
  .particle:nth-child(6) { left: 30%; animation-delay: 1.5s; }
  .particle:nth-child(7) { left: 35%; animation-delay: 1.8s; }
  .particle:nth-child(8) { left: 40%; animation-delay: 2.1s; }
  .particle:nth-child(9) { left: 45%; animation-delay: 2.4s; }
  .particle:nth-child(10) { left: 50%; animation-delay: 2.7s; }
  .particle:nth-child(11) { left: 55%; animation-delay: 3s; }
  .particle:nth-child(12) { left: 60%; animation-delay: 3.3s; }
  .particle:nth-child(13) { left: 65%; animation-delay: 3.6s; }
  .particle:nth-child(14) { left: 70%; animation-delay: 0.2s; }
  .particle:nth-child(15) { left: 75%; animation-delay: 0.5s; }
  .particle:nth-child(16) { left: 80%; animation-delay: 0.8s; }
  .particle:nth-child(17) { left: 85%; animation-delay: 1.1s; }
  .particle:nth-child(18) { left: 90%; animation-delay: 1.4s; }
  .particle:nth-child(19) { left: 95%; animation-delay: 1.7s; }
  .particle:nth-child(20) { left: 8%; animation-delay: 2s; }
  .particle:nth-child(21) { left: 18%; animation-delay: 2.3s; }
  .particle:nth-child(22) { left: 28%; animation-delay: 2.6s; }
  .particle:nth-child(23) { left: 38%; animation-delay: 2.9s; }
  .particle:nth-child(24) { left: 48%; animation-delay: 3.2s; }
  .particle:nth-child(25) { left: 58%; animation-delay: 0.4s; }
  .particle:nth-child(26) { left: 68%; animation-delay: 0.7s; }
  .particle:nth-child(27) { left: 78%; animation-delay: 1s; }
  .particle:nth-child(28) { left: 88%; animation-delay: 1.3s; }
  .particle:nth-child(29) { left: 12%; animation-delay: 1.6s; }
  .particle:nth-child(30) { left: 92%; animation-delay: 1.9s; }

  @media (max-width: 720px) {
    .splash-title {
      font-size: 2.8rem;
    }

    .splash-subtitle {
      font-size: 1rem;
      letter-spacing: 0.1em;
    }

    .logo-circle {
      width: 120px;
      height: 120px;
    }

    .emoji {
      font-size: 2.5rem;
    }

    .loading-bar {
      width: 85vw;
    }

    .shape {
      font-size: 2rem;
    }

    .circle, .square {
      width: 40px;
      height: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-splash,
    .splash-content,
    .splash-logo,
    .logo-circle,
    .sparkle,
    .heart,
    .emoji,
    .splash-letter,
    .splash-subtitle,
    .loading-bar,
    .loading-progress,
    .loading-dot,
    .shape,
    .particle {
      animation: none !important;
    }

    .welcome-splash {
      display: none;
    }
  }
</style>

<script>
  // Remove splash screen after animation
  const splash = document.getElementById('welcome-splash');
  if (splash && !sessionStorage.getItem('splashShown')) {
    sessionStorage.setItem('splashShown', 'true');
    setTimeout(() => {
      splash.remove();
    }, 4000);
  } else if (splash) {
    // If already shown this session, hide immediately
    splash.remove();
  }
</script>

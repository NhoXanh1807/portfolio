---
import AboutHeroImage from "../assets/4753d776ae8b2e1bd3ba05289ad27f8b.gif";
import Layout from "../layouts/BlogPost.astro";
import AnimatedBackground from "../components/AnimatedBackground.astro";

const personalDetails = [
  { label: "Name", value: "WangTe0f" },
  { label: "Job", value: "Security Engineer" },
  { label: "Location", value: "Ho Chi Minh City, Vietnam" },
  { label: "Experience", value: "1+ years in security" },
  { label: "Email", value: "nguyenbanhatquang1807@gmail.com" },
  { label: "Interests", value: "SOC Analysis, Incident Responder, CTFs" }
];

const tools = [
  { name: "Burp Suite", image: "../../public/images/tools/burpsuite-20231229161748.png" },
  { name: "Wireshark", image: "../../public/images/tools/Wireshark_icon_new.png" },
  { name: "Volatility", image: "../../public/images/tools/6001145.png" },
  { name: "FTK Imager", image: "../../public/images/tools/ftk_imager.png" },
  { name: "Autospy", image: "../../public/images/tools/autospy.png" }
];

const certifications = [
  {
    title: "AWS Certified Solutions Architect – Associate",
    issuer: "Amazon Web Service",
    year: "2025",
    link: "https://www.credly.com/earner/earned/badge/ff1fb4d4-d936-462f-aac6-af72bd507908",
    image: "../../public/images/cert/aws-certified-solutions-architect-associate.png" 
  }


];
---

<Layout
  title="About Me"
  description="WangTe0f's journey in cybersecurity and offensive research"
  pubDate={new Date("August 08 2021")}
  heroImage={AboutHeroImage}
>
  <section class="about-intro" data-animate="slide-right">
    <h2>Personal Information</h2>
    <div class="about-grid">
      {personalDetails.map((item) => (
        <div class="info-card">
          <span class="info-label">{item.label}</span>
          <span class="info-value">{item.value}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="about-mission" data-animate="zoom">
    <h2>Career Mission &amp; Philosophy</h2>
    <p>
      Passwords are like underwear: don't let people see them, change them regularly, and don't share them with strangers.
    </p>
  </section>

  <section class="about-tools" data-animate="slide-left">
    <h2>Daily Toolbelt</h2>
    <div class="tools-track">
      {tools.map((tool) => (
        <div class="tool-chip">
          <img src={tool.image} alt={tool.name} class="tool-image" />
          <span class="tool-name">{tool.name}</span>
        </div>
      ))}
    </div>
  </section>

<section class="about-certs" data-animate="blur">
  <h2>Certifications</h2>
  <div class="cert-slider" tabindex="0">
    {certifications.map((cert) => (
      <a class="cert-card" href={cert.link} target="_blank" rel="noreferrer">
        <img src={cert.image} alt={cert.title} class="cert-image" />
        <span class="cert-title">{cert.title}</span>
        <span class="cert-issuer">{cert.issuer}</span>
        <span class="cert-year">{cert.year}</span>
      </a>
    ))}
  </div>
</section>




<style>
  .about-intro,
  .about-mission,
  .about-tools,
  .about-certs,
  .about-closing {
    margin-bottom: 2.5rem;
  }

  .about-intro h2,
  .about-mission h2,
  .about-tools h2,
  .about-certs h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.35rem, 1.2rem + 0.4vw, 1.75rem);
    color: rgb(var(--black));
  }

  .about-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .info-card {
    border-radius: 1rem;
    padding: 1rem;
    background: rgba(var(--surface-rgb), 0.85);
    box-shadow: inset 0 0 0 1px rgba(var(--black), 0.05), 0 12px 30px rgba(var(--black), 0.1);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .info-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(var(--accent), 0.1), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .info-card:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: inset 0 0 0 1px rgba(var(--accent), 0.2), 0 18px 40px rgba(var(--black), 0.15);
  }

  .info-card:hover::before {
    opacity: 1;
  }

  .info-label {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(var(--black), 0.55);
  }

  .info-value {
    font-weight: 600;
    color: rgb(var(--black));
  }

  .about-mission p {
    line-height: 1.75;
  }

  .tools-track {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 0.75rem 1rem;
    border-radius: 999px;
    background: linear-gradient(120deg, rgba(14, 165, 233, 0.15), rgba(16, 185, 129, 0.18));
    box-shadow: inset 0 0 0 1px rgba(var(--black), 0.06);
    justify-content: center;
  }

  .tool-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.65rem 1rem;
    border-radius: 999px;
    background: rgba(var(--surface-rgb), 0.9);
    box-shadow: 0 10px 24px rgba(var(--black), 0.1);
    transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
    cursor: default;
  }

  .tool-chip:hover {
    transform: translateY(-4px) rotate(5deg) scale(1.1);
    box-shadow: 0 14px 32px rgba(var(--accent), 0.25);
  }

  .tool-icon {
    font-size: 1.35rem;
  }

  .tool-name {
    font-weight: 600;
  }

  .about-certs {
    position: relative;
  }

  .cert-note {
    margin-bottom: 1rem;
    font-size: 0.95rem;
    color: rgba(var(--black), 0.65);
  }

  .cert-slider {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 1fr);
    gap: 1.25rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scroll-snap-type: x mandatory;
  }

  .cert-slider::-webkit-scrollbar {
    height: 6px;
  }

  .cert-slider::-webkit-scrollbar-thumb {
    background: rgba(var(--black), 0.2);
    border-radius: 999px;
  }

  .cert-card {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.25rem;
    border-radius: 1rem;
    background: rgba(var(--surface-rgb), 0.92);
    box-shadow: 0 12px 28px rgba(var(--black), 0.12);
    text-decoration: none;
    color: inherit;
    scroll-snap-align: start;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .cert-card:hover,
  .cert-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 18px 36px rgba(var(--black), 0.18);
  }

  .cert-title {
    font-weight: 700;
  }

  .cert-issuer {
    font-size: 0.9rem;
    color: rgba(var(--black), 0.65);
  }

  .cert-year {
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(var(--black), 0.5);
  }

  .about-closing p {
    margin: 0;
    line-height: 1.7;
  }

  .cert-image {
  width: 50px;
  height: 50px;
  object-fit: contain;
  border-radius: 4px;
  }

  .tool-image {
  width: 32px;
  height: 32px;
  object-fit: contain;
  border-radius: 4px;
  }

  @media (max-width: 720px) {
    .tools-track {
      border-radius: 1.5rem;
    }

    .cert-slider {
      grid-auto-columns: minmax(180px, 80%);
    }
  }
</style>

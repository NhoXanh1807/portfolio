---
// Animated Background with Particles
---

<div class="animated-bg" aria-hidden="true">
  <div class="particles-container">
    {Array.from({ length: 12 }).map(() => (
      <div class="particle"></div>
    ))}
  </div>
  <div class="gradient-orbs">
    <div class="gradient-orb orb-1"></div>
    <div class="gradient-orb orb-2"></div>
    <div class="gradient-orb orb-3"></div>
  </div>
  <div class="animated-mesh"></div>
</div>

<style>
  .animated-bg {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .particles-container {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .particle {
    position: absolute;
    border-radius: 50%;
    opacity: 0;
    animation: particleFloat var(--duration) linear infinite;
    --duration: calc(12s + (var(--random) * 18s));
    box-shadow: 0 0 6px currentColor;
    will-change: transform, opacity;
  }

  .particle:nth-child(5n+1) { background: #ff6b9d; }
  .particle:nth-child(5n+2) { background: #c084fc; }
  .particle:nth-child(5n+3) { background: #60a5fa; }
  .particle:nth-child(5n+4) { background: #34d399; }
  .particle:nth-child(5n+5) { background: #fbbf24; }

  .particle:nth-child(1) { left: 10%; --random: 0.2; width: 3px; height: 3px; animation-delay: -2s; }
  .particle:nth-child(2) { left: 20%; --random: 0.5; width: 4px; height: 4px; animation-delay: -5s; }
  .particle:nth-child(3) { left: 30%; --random: 0.8; width: 2px; height: 2px; animation-delay: -8s; }
  .particle:nth-child(4) { left: 40%; --random: 0.3; width: 3px; height: 3px; animation-delay: -3s; }
  .particle:nth-child(5) { left: 50%; --random: 0.9; width: 3px; height: 3px; animation-delay: -10s; }
  .particle:nth-child(6) { left: 60%; --random: 0.4; width: 4px; height: 4px; animation-delay: -6s; }
  .particle:nth-child(7) { left: 70%; --random: 0.7; width: 2px; height: 2px; animation-delay: -9s; }
  .particle:nth-child(8) { left: 80%; --random: 0.6; width: 3px; height: 3px; animation-delay: -11s; }
  .particle:nth-child(9) { left: 90%; --random: 0.5; width: 3px; height: 3px; animation-delay: -7s; }
  .particle:nth-child(10) { left: 25%; --random: 0.35; width: 4px; height: 4px; animation-delay: -4s; }
  .particle:nth-child(11) { left: 45%; --random: 0.65; width: 2px; height: 2px; animation-delay: -9s; }
  .particle:nth-child(12) { left: 75%; --random: 0.55; width: 3px; height: 3px; animation-delay: -5s; }

  @keyframes particleFloat {
    0% {
      transform: translate3d(0, 100vh, 0);
      opacity: 0;
    }
    10% {
      opacity: 0.6;
    }
    90% {
      opacity: 0.6;
    }
    100% {
      transform: translate3d(calc(var(--random) * 100px - 50px), -100px, 0);
      opacity: 0;
    }
  }

  .gradient-orbs {
    position: absolute;
    width: 100%;
    height: 100%;
  }

  .gradient-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.25;
    mix-blend-mode: normal;
    will-change: transform;
  }

  .orb-1 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.35), transparent 70%);
    top: 15%;
    left: -5%;
    animation: orbFloat1 20s ease-in-out infinite;
  }

  .orb-2 {
    width: 450px;
    height: 450px;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.3), transparent 70%);
    top: 50%;
    right: -10%;
    animation: orbFloat2 25s ease-in-out infinite;
  }

  .orb-3 {
    width: 380px;
    height: 380px;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.3), transparent 70%);
    bottom: 20%;
    left: 40%;
    animation: orbFloat3 22s ease-in-out infinite;
  }

  @keyframes orbFloat1 {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(60px, -50px, 0) scale(1.08);
    }
  }

  @keyframes orbFloat2 {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(-70px, 40px, 0) scale(1.1);
    }
  }

  @keyframes orbFloat3 {
    0%, 100% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    50% {
      transform: translate3d(50px, 60px, 0) scale(1.05);
    }
  }

  .animated-mesh {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(99, 102, 241, 0.03) 2px, transparent 2px),
      linear-gradient(90deg, rgba(99, 102, 241, 0.03) 2px, transparent 2px);
    background-size: 60px 60px;
    animation: meshMove 20s linear infinite;
    opacity: 0.4;
  }

  @keyframes meshMove {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(60px, 60px, 0);
    }
  }

  html[data-theme="dark"] .orb-1 {
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3), transparent 70%);
  }

  html[data-theme="dark"] .orb-2 {
    background: radial-gradient(circle, rgba(139, 92, 246, 0.28), transparent 70%);
  }

  html[data-theme="dark"] .orb-3 {
    background: radial-gradient(circle, rgba(59, 130, 246, 0.28), transparent 70%);
  }

  html[data-theme="dark"] .animated-mesh {
    background-image:
      linear-gradient(rgba(139, 92, 246, 0.05) 2px, transparent 2px),
      linear-gradient(90deg, rgba(139, 92, 246, 0.05) 2px, transparent 2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .particle,
    .gradient-orb,
    .animated-mesh {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .particle {
      display: none;
    }
    .gradient-orb {
      filter: blur(30px);
      opacity: 0.2;
    }
  }
</style>

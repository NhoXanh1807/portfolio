---
// Cursor Glow Effect Component (Desktop only)
---

<div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>

<style>
  .cursor-glow {
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    opacity: 0;
    background:
      radial-gradient(
        circle,
        rgba(251, 113, 133, 0.2),
        rgba(167, 139, 250, 0.15),
        rgba(59, 130, 246, 0.1),
        transparent 70%
      );
    transition: opacity 0.3s ease;
    mix-blend-mode: screen;
    transform: translate(-50%, -50%);
    animation: cursorRainbow 8s ease-in-out infinite;
    filter: blur(30px);
  }

  @keyframes cursorRainbow {
    0%, 100% {
      background:
        radial-gradient(
          circle,
          rgba(251, 113, 133, 0.2),
          rgba(167, 139, 250, 0.15),
          rgba(59, 130, 246, 0.1),
          transparent 70%
        );
    }
    25% {
      background:
        radial-gradient(
          circle,
          rgba(167, 139, 250, 0.2),
          rgba(59, 130, 246, 0.15),
          rgba(52, 211, 153, 0.1),
          transparent 70%
        );
    }
    50% {
      background:
        radial-gradient(
          circle,
          rgba(59, 130, 246, 0.2),
          rgba(52, 211, 153, 0.15),
          rgba(251, 191, 36, 0.1),
          transparent 70%
        );
    }
    75% {
      background:
        radial-gradient(
          circle,
          rgba(52, 211, 153, 0.2),
          rgba(251, 191, 36, 0.15),
          rgba(251, 113, 133, 0.1),
          transparent 70%
        );
    }
  }

  @media (max-width: 1024px) {
    .cursor-glow {
      display: none;
    }
  }

  @media (hover: none) {
    .cursor-glow {
      display: none;
    }
  }

  html[data-theme="dark"] .cursor-glow {
    filter: blur(40px);
  }

  @keyframes cursorRainbowDark {
    0%, 100% {
      background:
        radial-gradient(
          circle,
          rgba(251, 113, 133, 0.3),
          rgba(167, 139, 250, 0.2),
          rgba(59, 130, 246, 0.15),
          transparent 70%
        );
    }
    25% {
      background:
        radial-gradient(
          circle,
          rgba(167, 139, 250, 0.3),
          rgba(59, 130, 246, 0.2),
          rgba(52, 211, 153, 0.15),
          transparent 70%
        );
    }
    50% {
      background:
        radial-gradient(
          circle,
          rgba(59, 130, 246, 0.3),
          rgba(52, 211, 153, 0.2),
          rgba(251, 191, 36, 0.15),
          transparent 70%
        );
    }
    75% {
      background:
        radial-gradient(
          circle,
          rgba(52, 211, 153, 0.3),
          rgba(251, 191, 36, 0.2),
          rgba(251, 113, 133, 0.15),
          transparent 70%
        );
    }
  }

  html[data-theme="dark"] .cursor-glow {
    animation: cursorRainbowDark 8s ease-in-out infinite;
  }
</style>

<script>
  const cursorGlow = document.getElementById('cursor-glow');

  if (cursorGlow && window.matchMedia('(min-width: 1025px)').matches && window.matchMedia('(hover: hover)').matches) {
    let mouseX = 0;
    let mouseY = 0;
    let glowX = 0;
    let glowY = 0;

    // Track mouse position
    document.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      cursorGlow.style.opacity = '1';
    });

    // Hide glow when mouse leaves window
    document.addEventListener('mouseleave', () => {
      cursorGlow.style.opacity = '0';
    });

    // Smooth animation loop
    function animate() {
      // Smooth interpolation for glow position
      const dx = mouseX - glowX;
      const dy = mouseY - glowY;

      glowX += dx * 0.15;
      glowY += dy * 0.15;

      cursorGlow.style.left = `${glowX}px`;
      cursorGlow.style.top = `${glowY}px`;

      requestAnimationFrame(animate);
    }

    animate();
  }
</script>

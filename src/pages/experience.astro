---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AnimatedBackground from "../components/AnimatedBackground.astro";
import { SITE_TITLE } from "../consts";
const pageTitle = "Experience | " + SITE_TITLE;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={pageTitle} />
	</head>
	<body>
		<AnimatedBackground />
		<Header />
                <main>
                        <header class="page-header" data-animate>
				<h1>Experience</h1>
				<p>
					My Experience ...
				</p>
			</header>

                        <section class="timeline" data-animate="stagger">
				<article class="role">
					<div class="role-header">
						<h2>Intern Security Engineer</h2>
						<p class="meta">June 2025 - Present | Coinhako Fintech Platform</p>
					</div>
					<div class="logo-strip" aria-label="Fintech Platform logo placeholder">
						<img src="/images/experience/fintech/download.png" alt="Fintech Platform logo" loading="lazy" />
					</div>
					<p class="overview">
						Montionring the threats and enhancing the effectiveness for the security team of the product company
					</p>
					<ul class="wins">
						<li>Monitoring Cloudfare, Crowdstrike, Datadog, CyberArk, AWS, Hacker1</li>
						<li>Build the Automation workflow for Threat Intelligence, Security Detection and Reponse</li>
						<li>Write Sigma rule and support for implementation of Detection Engine</li>
					</ul>
					<div class="gallery" aria-label="Fintech team moments">
						<figure>
							<img src="/images/experience/fintech/download.jpeg" alt="Security Bootcamp" loading="lazy" />
							<figcaption>Coinhako security team at Security Bootcamp 2025</figcaption>
						</figure>
						<figure>
							<img src="/images/experience/fintech/tabletop.jpg" alt="Tabletop dry run" loading="lazy" />
							<figcaption>Near Future</figcaption>
						</figure>
					</div>
					<section class="reflection">
						<h3>What the team taught me</h3>
						<p>
							Too many to remember -.-
					</section>
				</article>

				<article class="role">
					<div class="role-header">
						<h2>Forensics CTF Player</h2>
						<p class="meta">Oct 2025 - Present | Bach Khoa Information Security Club</p>
					</div>
					<div class="logo-strip" aria-label="MSP logo placeholder">
						<img src="/images/experience/club/images.png" alt="Managed Security Provider logo" loading="lazy" />
					</div>
					<p class="overview">
						Play CTF, ....
					</p>
					<ul class="wins">
						<li>Recently join so don't do anything more</li>
					</ul>
					<div class="gallery" aria-label="Consulting field photos">
						<figure>
							<img src="/images/experience/msp/ir-standup.jpg" alt="Incident response standup" loading="lazy" />
							<figcaption>Near Future</figcaption>
						</figure>
						<figure>
							<img src="/images/experience/msp/workshop.jpg" alt="SOC workshop" loading="lazy" />
							<figcaption>Near Future</figcaption>
						</figure>
					</div>
					<section class="reflection">
						<h3>Why this crew stands out</h3>
						<p>
							Very good environment
						</p>
					</section>
				</article>

				
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 1080px;
		margin: 0 auto;
		padding: 3.5rem 1.75rem 5rem;
	}
	.page-header {
		margin-bottom: 3rem;
	}
	.page-header p {
		max-width: 70ch;
	}
	.timeline {
		display: grid;
		gap: 3rem;
	}
	.role {
		background: rgb(var(--surface-rgb));
		border-radius: 1.5rem;
		box-shadow: var(--box-shadow);
		padding: 2.2rem 2rem 2.5rem;
		display: grid;
		gap: 1.5rem;
		border: 1px solid rgba(var(--accent), 0.08);
	}
	.role-header h2 {
		margin-bottom: 0.35rem;
	}
	.meta {
		margin: 0;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(var(--gray), 0.85);
	}
	.logo-strip {
		display: flex;
		justify-content: flex-start;
		align-items: center;
		gap: 1rem;
		padding: 0.75rem 1rem;
		border-radius: 1rem;
		background: rgba(var(--gray-light), 0.3);
	}
	.logo-strip img {
		height: 46px;
		width: auto;
		filter: saturate(0.85);
	}
	.overview {
		margin: 0;
		font-size: 1.05rem;
		line-height: 1.7;
	}
	.wins {
		margin: 0;
		padding-left: 1.25rem;
		line-height: 1.7;
	}
	.gallery {
		display: grid;
		gap: 1.5rem;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
	}
	.gallery figure {
		margin: 0;
		background: rgba(var(--gray-light), 0.25);
		border-radius: 1.1rem;
		padding: 1rem;
		display: grid;
		gap: 0.75rem;
		box-shadow: inset 0 0 0 1px rgba(var(--accent), 0.08);
	}
	.gallery img {
		width: 100%;
		height: auto;
		border-radius: 0.75rem;
		object-fit: cover;
	}
	figcaption {
		font-size: 0.9rem;
		color: rgba(var(--gray-dark), 0.85);
	}
	.reflection {
		padding: 1.25rem 1.5rem;
		border-radius: 1.1rem;
		background: rgba(var(--accent), 0.12);
		color: var(--accent);
	}
	.reflection h3 {
		margin-top: 0;
		margin-bottom: 0.75rem;
	}
	@media (max-width: 720px) {
		main {
			padding: 2.5rem 1.25rem 4rem;
		}
		.role {
			padding: 1.75rem 1.5rem 2rem;
		}
		.logo-strip {
			justify-content: center;
		}
	}
</style>



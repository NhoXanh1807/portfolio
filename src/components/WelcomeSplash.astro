---
// Welcome Splash Screen Component - Tech Cyber Edition
---

<div id="welcome-splash" class="welcome-splash">
  <div class="splash-content">
    <div class="splash-logo">
      <div class="logo-hexagon">
        <!-- Tech Hexagon Icon -->
        <svg viewBox="0 0 100 100" class="tech-icon">
          <!-- Hexagon shapes -->
          <polygon points="50,10 90,30 90,70 50,90 10,70 10,30"
                   fill="none" stroke="currentColor" stroke-width="2"
                   class="hex-outline hex-1" />
          <polygon points="50,20 80,35 80,65 50,80 20,65 20,35"
                   fill="none" stroke="currentColor" stroke-width="2"
                   class="hex-outline hex-2" />
          <polygon points="50,30 70,40 70,60 50,70 30,60 30,40"
                   fill="currentColor" class="hex-core" opacity="0.3" />
          <!-- Circuit nodes -->
          <circle cx="50" cy="10" r="3" fill="currentColor" class="node node-1" />
          <circle cx="90" cy="30" r="3" fill="currentColor" class="node node-2" />
          <circle cx="90" cy="70" r="3" fill="currentColor" class="node node-3" />
          <circle cx="50" cy="90" r="3" fill="currentColor" class="node node-4" />
          <circle cx="10" cy="70" r="3" fill="currentColor" class="node node-5" />
          <circle cx="10" cy="30" r="3" fill="currentColor" class="node node-6" />
        </svg>
      </div>
    </div>
    <h1 class="splash-title">
      <span class="splash-letter">S</span>
      <span class="splash-letter">Y</span>
      <span class="splash-letter">S</span>
      <span class="splash-letter">T</span>
      <span class="splash-letter">E</span>
      <span class="splash-letter">M</span>
    </h1>
    <p class="splash-subtitle">INITIALIZING SECURITY PROTOCOLS...</p>
    <div class="loading-bar">
      <div class="loading-progress"></div>
      <div class="loading-glitch"></div>
    </div>
    <div class="loading-text">LOADING: <span class="loading-percent">0%</span></div>
  </div>

  <!-- Circuit Grid -->
  <div class="circuit-grid" aria-hidden="true">
    {Array.from({ length: 20 }).map((_, i) => (
      <div class={`circuit-line circuit-${(i % 4) + 1}`}></div>
    ))}
  </div>

  <!-- Scan Lines -->
  <div class="scan-lines" aria-hidden="true">
    <div class="scan-line scan-1"></div>
    <div class="scan-line scan-2"></div>
    <div class="scan-line scan-3"></div>
  </div>

  <!-- Angular Particles -->
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 12 }).map((_, i) => (
      <div class={`particle particle-${(i % 3) + 1}`}></div>
    ))}
  </div>
</div>

<style>
  .welcome-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background:
      linear-gradient(135deg,
        rgba(0, 0, 0, 0.98),
        rgba(5, 10, 20, 0.95),
        rgba(0, 15, 30, 0.96)
      ),
      repeating-linear-gradient(
        0deg,
        rgba(0, 217, 255, 0.02) 0px,
        transparent 2px,
        transparent 4px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(0, 255, 65, 0.02) 0px,
        transparent 2px,
        transparent 4px
      );
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation: splashFadeOut 0.8s ease-in-out 3s forwards;
    pointer-events: none;
  }

  @keyframes splashFadeOut {
    to {
      opacity: 0;
      visibility: hidden;
      transform: scale(1.1);
    }
  }

  .splash-content {
    text-align: center;
    color: #00d9ff;
    position: relative;
    z-index: 2;
    animation: contentGlitchIn 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes contentGlitchIn {
    0% {
      opacity: 0;
      transform: translateY(40px);
      filter: blur(10px);
    }
    50% {
      transform: translateY(-5px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
    }
  }

  .splash-logo {
    margin-bottom: 2.5rem;
    animation: logoReveal 1s ease-out;
  }

  @keyframes logoReveal {
    0% {
      opacity: 0;
      transform: scale(0.5) rotateY(180deg);
    }
    100% {
      opacity: 1;
      transform: scale(1) rotateY(0deg);
    }
  }

  .logo-hexagon {
    width: 160px;
    height: 160px;
    margin: 0 auto;
    background:
      linear-gradient(135deg,
        rgba(0, 217, 255, 0.1),
        rgba(0, 255, 65, 0.05)
      );
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 40px rgba(0, 217, 255, 0.5),
      0 0 80px rgba(0, 255, 65, 0.3),
      inset 0 0 20px rgba(0, 217, 255, 0.2);
    position: relative;
    animation: hexagonPulse 2s ease-in-out infinite;
    border: 2px solid rgba(0, 217, 255, 0.6);
  }

  @keyframes hexagonPulse {
    0%, 100% {
      box-shadow:
        0 0 40px rgba(0, 217, 255, 0.5),
        0 0 80px rgba(0, 255, 65, 0.3),
        inset 0 0 20px rgba(0, 217, 255, 0.2);
      transform: scale(1);
    }
    50% {
      box-shadow:
        0 0 60px rgba(0, 217, 255, 0.7),
        0 0 120px rgba(0, 255, 65, 0.5),
        inset 0 0 30px rgba(0, 217, 255, 0.3);
      transform: scale(1.05);
    }
  }

  .tech-icon {
    width: 100px;
    height: 100px;
    color: #00d9ff;
    filter: drop-shadow(0 0 10px rgba(0, 217, 255, 0.8));
  }

  .hex-outline {
    animation: hexRotate 8s linear infinite;
    transform-origin: center;
  }

  .hex-1 {
    stroke: #00d9ff;
  }

  .hex-2 {
    stroke: #00ff41;
    animation-direction: reverse;
  }

  @keyframes hexRotate {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .hex-core {
    fill: #00d9ff;
    animation: corePulse 2s ease-in-out infinite;
  }

  @keyframes corePulse {
    0%, 100% {
      opacity: 0.3;
    }
    50% {
      opacity: 0.6;
    }
  }

  .node {
    animation: nodeBlink 1.5s ease-in-out infinite;
  }

  .node-1 { animation-delay: 0s; fill: #00d9ff; }
  .node-2 { animation-delay: 0.25s; fill: #00ff41; }
  .node-3 { animation-delay: 0.5s; fill: #00d9ff; }
  .node-4 { animation-delay: 0.75s; fill: #00ff41; }
  .node-5 { animation-delay: 1s; fill: #00d9ff; }
  .node-6 { animation-delay: 1.25s; fill: #00ff41; }

  @keyframes nodeBlink {
    0%, 100% {
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
  }

  .splash-title {
    font-size: clamp(3rem, 10vw, 5rem);
    font-weight: 900;
    margin: 0 0 1.5rem 0;
    letter-spacing: 0.2em;
    display: flex;
    justify-content: center;
    gap: 0.15em;
    font-family: var(--font-mono);
    background: linear-gradient(
      90deg,
      #00d9ff,
      #00ff41,
      #00d9ff
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: cyberFlow 3s linear infinite;
    text-shadow:
      0 0 40px rgba(0, 217, 255, 0.5),
      0 0 80px rgba(0, 255, 65, 0.3);
  }

  @keyframes cyberFlow {
    0% {
      background-position: 0% center;
      filter: brightness(1);
    }
    50% {
      filter: brightness(1.3);
    }
    100% {
      background-position: 200% center;
      filter: brightness(1);
    }
  }

  .splash-letter {
    display: inline-block;
    opacity: 0;
    animation: letterGlitch 0.6s ease-out forwards;
  }

  .splash-letter:nth-child(1) { animation-delay: 0.1s; }
  .splash-letter:nth-child(2) { animation-delay: 0.15s; }
  .splash-letter:nth-child(3) { animation-delay: 0.2s; }
  .splash-letter:nth-child(4) { animation-delay: 0.25s; }
  .splash-letter:nth-child(5) { animation-delay: 0.3s; }
  .splash-letter:nth-child(6) { animation-delay: 0.35s; }

  @keyframes letterGlitch {
    0% {
      opacity: 0;
      transform: translateX(-50px) skewX(-20deg);
      filter: blur(10px);
    }
    40% {
      transform: translateX(5px) skewX(10deg);
      filter: blur(2px);
    }
    60% {
      transform: translateX(-3px) skewX(-5deg);
    }
    80% {
      transform: translateX(2px) skewX(3deg);
    }
    100% {
      opacity: 1;
      transform: translateX(0) skewX(0);
      filter: blur(0);
    }
  }

  .splash-subtitle {
    font-size: clamp(0.9rem, 2vw, 1.2rem);
    font-weight: 700;
    margin: 0 0 2rem 0;
    opacity: 0;
    letter-spacing: 0.15em;
    color: #00ff41;
    font-family: var(--font-mono);
    text-shadow:
      0 0 10px rgba(0, 255, 65, 0.8),
      0 0 20px rgba(0, 217, 255, 0.5);
    animation: subtitleScan 0.8s ease-out 0.6s forwards, textFlicker 2s infinite 1.5s;
  }

  @keyframes subtitleScan {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  @keyframes textFlicker {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.85;
    }
  }

  .loading-bar {
    width: clamp(250px, 70vw, 500px);
    height: 4px;
    background: rgba(0, 0, 0, 0.6);
    border-radius: 0;
    overflow: hidden;
    margin: 0 auto 1rem;
    opacity: 0;
    animation: loadingBarFade 0.3s ease-out 1s forwards;
    box-shadow:
      0 0 10px rgba(0, 217, 255, 0.3),
      inset 0 0 5px rgba(0, 0, 0, 0.5);
    border: 1px solid rgba(0, 217, 255, 0.4);
    position: relative;
  }

  @keyframes loadingBarFade {
    to {
      opacity: 1;
    }
  }

  .loading-progress {
    height: 100%;
    background: linear-gradient(
      90deg,
      #00d9ff,
      #00ff41,
      #00d9ff
    );
    background-size: 200% 100%;
    border-radius: 0;
    animation:
      loadingProgress 2.5s ease-out 1s forwards,
      cyberSlide 1s linear infinite;
    width: 0;
    box-shadow:
      0 0 20px rgba(0, 217, 255, 0.8),
      0 0 40px rgba(0, 255, 65, 0.6);
    position: relative;
  }

  .loading-glitch {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
    animation: glitchSweep 2s ease-in-out infinite;
  }

  @keyframes loadingProgress {
    to {
      width: 100%;
    }
  }

  @keyframes cyberSlide {
    0% {
      background-position: 0% center;
    }
    100% {
      background-position: 200% center;
    }
  }

  @keyframes glitchSweep {
    0%, 100% {
      transform: translateX(-100%);
    }
    50% {
      transform: translateX(100%);
    }
  }

  .loading-text {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: #00d9ff;
    letter-spacing: 0.15em;
    font-weight: 700;
    opacity: 0;
    animation: loadingBarFade 0.3s ease-out 1s forwards;
    text-shadow: 0 0 10px rgba(0, 217, 255, 0.5);
  }

  .loading-percent {
    color: #00ff41;
  }

  /* Circuit Grid */
  .circuit-grid {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
    opacity: 0.3;
  }

  .circuit-line {
    position: absolute;
    background: linear-gradient(90deg, transparent, rgba(0, 217, 255, 0.6), transparent);
    animation: circuitFlow 3s linear infinite;
  }

  .circuit-1 {
    width: 2px;
    height: 100%;
    left: 15%;
    animation-delay: 0s;
  }

  .circuit-2 {
    width: 100%;
    height: 2px;
    top: 25%;
    animation-delay: 0.5s;
  }

  .circuit-3 {
    width: 2px;
    height: 100%;
    left: 85%;
    animation-delay: 1s;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 65, 0.6), transparent);
  }

  .circuit-4 {
    width: 100%;
    height: 2px;
    top: 75%;
    animation-delay: 1.5s;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 65, 0.6), transparent);
  }

  @keyframes circuitFlow {
    0%, 100% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.8;
    }
  }

  /* Scan Lines */
  .scan-lines {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  .scan-line {
    position: absolute;
    width: 100%;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(0, 217, 255, 0.8), transparent);
    box-shadow: 0 0 10px rgba(0, 217, 255, 0.8);
    animation: scanMove 3s linear infinite;
  }

  .scan-1 {
    top: 0;
    animation-delay: 0s;
  }

  .scan-2 {
    top: 33%;
    animation-delay: 1s;
    background: linear-gradient(90deg, transparent, rgba(0, 255, 65, 0.8), transparent);
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.8);
  }

  .scan-3 {
    top: 66%;
    animation-delay: 2s;
  }

  @keyframes scanMove {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(100vh);
      opacity: 0;
    }
  }

  /* Angular Particles */
  .particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
    pointer-events: none;
  }

  .particle {
    position: absolute;
    width: 6px;
    height: 6px;
    opacity: 0.7;
    animation: particleMove 4s linear infinite;
    clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%);
  }

  .particle-1 {
    background: #00d9ff;
    box-shadow: 0 0 8px #00d9ff;
  }

  .particle-2 {
    background: #00ff41;
    box-shadow: 0 0 8px #00ff41;
  }

  .particle-3 {
    background: rgba(0, 217, 255, 0.8);
    box-shadow: 0 0 6px rgba(0, 217, 255, 0.8);
  }

  .particle:nth-child(1) { left: 10%; top: 10%; animation-delay: 0s; animation-duration: 4.5s; }
  .particle:nth-child(2) { left: 30%; top: 60%; animation-delay: 0.5s; animation-duration: 4s; }
  .particle:nth-child(3) { left: 50%; top: 20%; animation-delay: 1s; animation-duration: 4.2s; }
  .particle:nth-child(4) { left: 70%; top: 80%; animation-delay: 1.5s; animation-duration: 4.3s; }
  .particle:nth-child(5) { left: 20%; top: 40%; animation-delay: 2s; animation-duration: 4.1s; }
  .particle:nth-child(6) { left: 85%; top: 30%; animation-delay: 2.5s; animation-duration: 4.4s; }
  .particle:nth-child(7) { left: 40%; top: 85%; animation-delay: 3s; animation-duration: 4.2s; }
  .particle:nth-child(8) { left: 60%; top: 15%; animation-delay: 3.5s; animation-duration: 4s; }
  .particle:nth-child(9) { left: 15%; top: 70%; animation-delay: 0.8s; animation-duration: 4.3s; }
  .particle:nth-child(10) { left: 80%; top: 50%; animation-delay: 1.3s; animation-duration: 4.1s; }
  .particle:nth-child(11) { left: 45%; top: 35%; animation-delay: 1.8s; animation-duration: 4.2s; }
  .particle:nth-child(12) { left: 90%; top: 65%; animation-delay: 2.3s; animation-duration: 4.4s; }

  @keyframes particleMove {
    0% {
      transform: translateY(0) rotate(0deg);
      opacity: 0;
    }
    10% {
      opacity: 0.7;
    }
    90% {
      opacity: 0.7;
    }
    100% {
      transform: translateY(-100vh) rotate(360deg);
      opacity: 0;
    }
  }


  @media (max-width: 720px) {
    .splash-title {
      font-size: 2.8rem;
      letter-spacing: 0.15em;
    }

    .splash-subtitle {
      font-size: 0.8rem;
      letter-spacing: 0.12em;
    }

    .logo-hexagon {
      width: 120px;
      height: 120px;
    }

    .tech-icon {
      width: 80px;
      height: 80px;
    }

    .loading-bar {
      width: 85vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-splash,
    .splash-content,
    .splash-logo,
    .logo-hexagon,
    .tech-icon,
    .splash-letter,
    .splash-subtitle,
    .loading-bar,
    .loading-progress,
    .particle,
    .scan-line,
    .circuit-line {
      animation: none !important;
    }

    .welcome-splash {
      display: none;
    }
  }
</style>

<script>
  // Remove splash screen after animation
  const splash = document.getElementById('welcome-splash');
  if (splash && !sessionStorage.getItem('splashShown')) {
    sessionStorage.setItem('splashShown', 'true');

    // Update loading percentage
    const percentEl = splash.querySelector('.loading-percent');
    if (percentEl) {
      let percent = 0;
      const interval = setInterval(() => {
        percent += Math.floor(Math.random() * 15) + 5;
        if (percent >= 100) {
          percent = 100;
          clearInterval(interval);
        }
        percentEl.textContent = `${percent}%`;
      }, 100);
    }

    setTimeout(() => {
      splash.remove();
    }, 4000);
  } else if (splash) {
    // If already shown this session, hide immediately
    splash.remove();
  }
</script>

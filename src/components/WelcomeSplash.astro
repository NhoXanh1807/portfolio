---
// Welcome Splash Screen Component
---

<div id="welcome-splash" class="welcome-splash">
  <div class="splash-content">
    <div class="splash-logo">
      <div class="logo-circle">
        <svg viewBox="0 0 100 100" class="shield-icon">
          <path
            d="M50 10 L20 25 L20 50 Q20 75 50 90 Q80 75 80 50 L80 25 Z"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            class="shield-path"
          />
          <path
            d="M35 50 L45 60 L65 40"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            class="check-path"
          />
        </svg>
      </div>
    </div>
    <h1 class="splash-title">
      <span class="splash-letter">W</span>
      <span class="splash-letter">e</span>
      <span class="splash-letter">l</span>
      <span class="splash-letter">c</span>
      <span class="splash-letter">o</span>
      <span class="splash-letter">m</span>
      <span class="splash-letter">e</span>
    </h1>
    <p class="splash-subtitle">Entering the Security Realm</p>
    <div class="loading-bar">
      <div class="loading-progress"></div>
    </div>
  </div>
  <div class="particles" aria-hidden="true">
    {Array.from({ length: 20 }).map(() => (
      <div class="particle"></div>
    ))}
  </div>
</div>

<style>
  .welcome-splash {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: linear-gradient(
      135deg,
      rgba(99, 102, 241, 0.95),
      rgba(14, 165, 233, 0.95),
      rgba(16, 185, 129, 0.92)
    );
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    animation: splashFadeOut 0.8s ease-in-out 2.5s forwards;
    pointer-events: none;
  }

  @keyframes splashFadeOut {
    to {
      opacity: 0;
      visibility: hidden;
    }
  }

  .splash-content {
    text-align: center;
    color: white;
    position: relative;
    z-index: 2;
    animation: contentSlideUp 1s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes contentSlideUp {
    from {
      opacity: 0;
      transform: translateY(40px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .splash-logo {
    margin-bottom: 2rem;
    animation: logoReveal 1.2s cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes logoReveal {
    from {
      opacity: 0;
      transform: scale(0.5) rotate(-180deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  .logo-circle {
    width: 120px;
    height: 120px;
    margin: 0 auto;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 0 40px rgba(255, 255, 255, 0.3),
      0 0 80px rgba(99, 102, 241, 0.4);
    position: relative;
    animation: logoPulse 2s ease-in-out infinite;
  }

  @keyframes logoPulse {
    0%, 100% {
      box-shadow:
        0 0 40px rgba(255, 255, 255, 0.3),
        0 0 80px rgba(99, 102, 241, 0.4);
      transform: scale(1);
    }
    50% {
      box-shadow:
        0 0 50px rgba(255, 255, 255, 0.5),
        0 0 100px rgba(99, 102, 241, 0.6);
      transform: scale(1.05);
    }
  }

  .shield-icon {
    width: 60px;
    height: 60px;
    color: white;
  }

  .shield-path {
    stroke-dasharray: 300;
    stroke-dashoffset: 300;
    animation: drawShield 1.5s ease-out 0.3s forwards;
  }

  .check-path {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: drawCheck 0.6s ease-out 1.2s forwards;
  }

  @keyframes drawShield {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes drawCheck {
    to {
      stroke-dashoffset: 0;
    }
  }

  .splash-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    font-weight: 800;
    margin: 0 0 1rem 0;
    letter-spacing: 0.05em;
    display: flex;
    justify-content: center;
    gap: 0.1em;
  }

  .splash-letter {
    display: inline-block;
    opacity: 0;
    animation: letterPop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .splash-letter:nth-child(1) { animation-delay: 0.1s; }
  .splash-letter:nth-child(2) { animation-delay: 0.2s; }
  .splash-letter:nth-child(3) { animation-delay: 0.3s; }
  .splash-letter:nth-child(4) { animation-delay: 0.4s; }
  .splash-letter:nth-child(5) { animation-delay: 0.5s; }
  .splash-letter:nth-child(6) { animation-delay: 0.6s; }
  .splash-letter:nth-child(7) { animation-delay: 0.7s; }

  @keyframes letterPop {
    from {
      opacity: 0;
      transform: translateY(20px) rotate(-10deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(0deg);
    }
  }

  .splash-subtitle {
    font-size: clamp(1rem, 2vw, 1.4rem);
    font-weight: 400;
    margin: 0 0 2.5rem 0;
    opacity: 0;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: subtitleFade 0.8s ease-out 0.9s forwards;
  }

  @keyframes subtitleFade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 0.9;
      transform: translateY(0);
    }
  }

  .loading-bar {
    width: clamp(200px, 60vw, 400px);
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
    overflow: hidden;
    margin: 0 auto;
    opacity: 0;
    animation: loadingBarFade 0.5s ease-out 1.2s forwards;
  }

  @keyframes loadingBarFade {
    to {
      opacity: 1;
    }
  }

  .loading-progress {
    height: 100%;
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.8),
      rgba(255, 255, 255, 1),
      rgba(255, 255, 255, 0.8)
    );
    border-radius: 999px;
    animation: loadingProgress 2s ease-in-out 1.2s forwards;
    width: 0;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.8);
  }

  @keyframes loadingProgress {
    to {
      width: 100%;
    }
  }

  .particles {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 1;
  }

  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: white;
    border-radius: 50%;
    opacity: 0.6;
    animation: particleFloat 3s ease-in-out infinite;
  }

  .particle:nth-child(1) { left: 10%; top: 20%; animation-delay: 0s; }
  .particle:nth-child(2) { left: 20%; top: 80%; animation-delay: 0.2s; }
  .particle:nth-child(3) { left: 30%; top: 40%; animation-delay: 0.4s; }
  .particle:nth-child(4) { left: 40%; top: 60%; animation-delay: 0.6s; }
  .particle:nth-child(5) { left: 50%; top: 30%; animation-delay: 0.8s; }
  .particle:nth-child(6) { left: 60%; top: 70%; animation-delay: 1s; }
  .particle:nth-child(7) { left: 70%; top: 50%; animation-delay: 1.2s; }
  .particle:nth-child(8) { left: 80%; top: 25%; animation-delay: 1.4s; }
  .particle:nth-child(9) { left: 90%; top: 75%; animation-delay: 1.6s; }
  .particle:nth-child(10) { left: 15%; top: 55%; animation-delay: 1.8s; }
  .particle:nth-child(11) { left: 25%; top: 15%; animation-delay: 2s; }
  .particle:nth-child(12) { left: 35%; top: 85%; animation-delay: 2.2s; }
  .particle:nth-child(13) { left: 45%; top: 35%; animation-delay: 2.4s; }
  .particle:nth-child(14) { left: 55%; top: 65%; animation-delay: 2.6s; }
  .particle:nth-child(15) { left: 65%; top: 45%; animation-delay: 2.8s; }
  .particle:nth-child(16) { left: 75%; top: 55%; animation-delay: 3s; }
  .particle:nth-child(17) { left: 85%; top: 35%; animation-delay: 3.2s; }
  .particle:nth-child(18) { left: 12%; top: 65%; animation-delay: 3.4s; }
  .particle:nth-child(19) { left: 68%; top: 22%; animation-delay: 3.6s; }
  .particle:nth-child(20) { left: 42%; top: 78%; animation-delay: 3.8s; }

  @keyframes particleFloat {
    0%, 100% {
      transform: translateY(0) scale(1);
      opacity: 0.6;
    }
    50% {
      transform: translateY(-30px) scale(1.2);
      opacity: 1;
    }
  }

  @media (max-width: 720px) {
    .splash-title {
      font-size: 2.5rem;
    }

    .splash-subtitle {
      font-size: 0.9rem;
      letter-spacing: 0.15em;
    }

    .logo-circle {
      width: 100px;
      height: 100px;
    }

    .shield-icon {
      width: 50px;
      height: 50px;
    }

    .loading-bar {
      width: 80vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome-splash,
    .splash-content,
    .splash-logo,
    .logo-circle,
    .shield-path,
    .check-path,
    .splash-letter,
    .splash-subtitle,
    .loading-bar,
    .loading-progress,
    .particle {
      animation: none !important;
    }

    .welcome-splash {
      display: none;
    }
  }
</style>

<script>
  // Remove splash screen after animation
  const splash = document.getElementById('welcome-splash');
  if (splash && !sessionStorage.getItem('splashShown')) {
    sessionStorage.setItem('splashShown', 'true');
    setTimeout(() => {
      splash.remove();
    }, 3500);
  } else if (splash) {
    // If already shown this session, hide immediately
    splash.remove();
  }
</script>

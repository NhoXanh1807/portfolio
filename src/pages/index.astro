---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import AnimatedBackground from "../components/AnimatedBackground.astro";
import WelcomeSplash from "../components/WelcomeSplash.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import CursorGlow from "../components/CursorGlow.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <CursorGlow />
    <WelcomeSplash />
    <AnimatedBackground />
    <Header />
    <main>
      <section class="hero" data-animate="blur">
        <div class="hero-content" data-animate="slide-left">
          <p class="eyebrow">CYBERSECURITY NEWBIE</p>
          <h1>Learning, researching, working, playing CTF and relaxing more</h1>
          <p class="lede">
            I am a final year Computer Science student with the desire to
            graduate on time and passionate about Cyber Security
          </p>
          <div class="hero-actions">
            <a class="cta" href="/projects">View Projects</a>
            <a class="ghost" href="/writeups">Read Writeups</a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true" data-animate="pop">
          <button class="visual-toggle" aria-label="Toggle visual effects">
            <svg
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path d="M12 5v14M5 12h14"></path>
            </svg>
          </button>
          <div class="tech-grid">
            <div class="hex-grid">
              <div class="hexagon hex-1"></div>
              <div class="hexagon hex-2"></div>
              <div class="hexagon hex-3"></div>
              <div class="hexagon hex-4"></div>
              <div class="hexagon hex-5"></div>
              <div class="hexagon hex-6"></div>
            </div>
            <div class="circuit-lines">
              <div class="circuit-line line-1"></div>
              <div class="circuit-line line-2"></div>
              <div class="circuit-line line-3"></div>
              <div class="circuit-line line-4"></div>
            </div>
            <div class="geometric-shapes">
              <div class="triangle tri-1"></div>
              <div class="triangle tri-2"></div>
              <div class="triangle tri-3"></div>
              <div class="square sq-1"></div>
              <div class="square sq-2"></div>
            </div>
          </div>
          <div class="sharp-beams">
            <div class="beam beam-1"></div>
            <div class="beam beam-2"></div>
            <div class="beam beam-3"></div>
          </div>
          <div class="grid-overlay"></div>
          <div class="scan-line"></div>
        </div>
      </section>

      <section class="pillars" data-animate="zoom">
        <h2>Focus Areas</h2>
        <div class="pillars-grid" data-animate="stagger">
          <article class="pillar-card pillar-card--adversary">
            <span class="pillar-card__glow" aria-hidden="true"></span>
            <span class="pillar-card__pulse" aria-hidden="true"></span>
            <header>
              <h3>Malware Research</h3>
              <p class="pillar-subhead"></p>
            </header>
            <p>Learning ...</p>
          </article>
          <article class="pillar-card pillar-card--detect">
            <span class="pillar-card__glow" aria-hidden="true"></span>
            <span class="pillar-card__pulse" aria-hidden="true"></span>
            <header>
              <h3>SOC, Threat Detection &amp; Response</h3>
              <p class="pillar-subhead">
                Automation and playbooks that keep blue teams decisive.
              </p>
            </header>
            <p>
              Playbook, SOP, SIEM tuning, and automation that help blue teams
              react fast and contain incidents with confidence.
            </p>
          </article>
          <article class="pillar-card pillar-card--educate">
            <span class="pillar-card__glow" aria-hidden="true"></span>
            <span class="pillar-card__pulse" aria-hidden="true"></span>
            <header>
              <h3>Red Team</h3>
            </header>
            <p>Not yet :)))</p>
          </article>
        </div>
      </section>

      <section class="highlights" data-animate="stagger">
        <h2>What You Will Find Here</h2>
        <ul>
          <li>
            <strong>Projects</strong> - Security tooling, labs, and infrastructure
            hardening work with practical takeaways.
          </li>
          <li>
            <strong>Writeups</strong> - Post-exploitation notes, CTF walkthroughs,
            and vulnerability research with actionable lessons.
          </li>
          <li>
            <strong>Experience</strong> - Snapshots of consulting, in-house security
            roles
          </li>
          <li>
            <strong>Blog</strong> - My funny life stories
          </li>
        </ul>
      </section>

      <section class="next" data-animate="rotate-in">
        <h2>Need to connect with me ?</h2>
        <p>
          I am open to collaboration on security research, CTF challenges, or
          just gossip
        </p>
        <a class="ghost" href="mailto:nguyenbanhatquang1807@gmail.com"
          >Start a conversation</a
        >
      </section>
    </main>
    <Footer />
    <ScrollToTop />
    <script>
      // Mouse tracking effect for hero section
      document.addEventListener("DOMContentLoaded", () => {
        const hero = document.querySelector(".hero");
        if (hero) {
          hero.addEventListener("mousemove", (e) => {
            const rect = hero.getBoundingClientRect();
            const x = ((e.clientX - rect.left) / rect.width) * 100;
            const y = ((e.clientY - rect.top) / rect.height) * 100;
            hero.style.setProperty("--mouse-x", `${x}%`);
            hero.style.setProperty("--mouse-y", `${y}%`);
          });
        }

        // Visual toggle button for mobile
        const toggleBtn = document.querySelector(".visual-toggle");
        const techGrid = document.querySelector(".tech-grid");
        const beams = document.querySelector(".sharp-beams");
        const scanLine = document.querySelector(".scan-line");

        if (toggleBtn && techGrid) {
          let isActive = true;

          toggleBtn.addEventListener("click", () => {
            isActive = !isActive;

            if (isActive) {
              techGrid.style.display = "flex";
              if (beams) beams.style.display = "block";
              if (scanLine) scanLine.style.display = "block";
              toggleBtn.style.transform = "rotate(0deg)";
            } else {
              techGrid.style.display = "none";
              if (beams) beams.style.display = "none";
              if (scanLine) scanLine.style.display = "none";
              toggleBtn.style.transform = "rotate(45deg)";
            }
          });
        }
      });
    </script>
  </body>
</html>

<style>
  main {
    width: min(1180px, 92vw);
    margin: 0 auto;
    padding: clamp(3rem, 6vw, 4.75rem) clamp(1.25rem, 4vw, 3rem) 5rem;
    color: var(--black);
    display: grid;
    gap: clamp(2.75rem, 5vw, 3.5rem);
  }
  section {
    margin: 0;
  }
  .hero {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    grid-template-columns: minmax(320px, 0.58fr) minmax(260px, 0.42fr);
    align-items: center;
    background: linear-gradient(
        135deg,
        rgba(0, 20, 40, 0.95),
        rgba(10, 25, 45, 0.92)
      ),
      linear-gradient(
        45deg,
        rgba(0, 217, 255, 0.08) 0%,
        transparent 40%,
        rgba(0, 255, 65, 0.08) 100%
      );
    padding: clamp(2.75rem, 5vw, 4rem);
    border-radius: 0.5rem;
    position: relative;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(0, 217, 255, 0.3) inset,
      0 0 0 2px rgba(0, 0, 0, 0.8),
      0 20px 60px rgba(0, 217, 255, 0.25),
      0 40px 100px rgba(0, 0, 0, 0.5);
    isolation: isolate;
    clip-path: polygon(
      0 0,
      calc(100% - 2rem) 0,
      100% 2rem,
      100% 100%,
      2rem 100%,
      0 calc(100% - 2rem)
    );
    animation: heroEdgePulse 4s ease-in-out infinite;
  }
  .hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
        0deg,
        rgba(0, 217, 255, 0.03) 0px,
        transparent 2px,
        transparent 4px,
        rgba(0, 217, 255, 0.03) 4px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(0, 255, 65, 0.03) 0px,
        transparent 2px,
        transparent 4px,
        rgba(0, 255, 65, 0.03) 4px
      );
    opacity: 0.6;
    z-index: 0;
    pointer-events: none;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 217, 255, 0.8),
      rgba(0, 255, 65, 0.8),
      transparent
    );
    animation: scanTop 3s linear infinite;
  }
  @keyframes heroEdgePulse {
    0%,
    100% {
      box-shadow:
        0 0 0 1px rgba(0, 217, 255, 0.3) inset,
        0 0 0 2px rgba(0, 0, 0, 0.8),
        0 20px 60px rgba(0, 217, 255, 0.25),
        0 40px 100px rgba(0, 0, 0, 0.5);
    }
    50% {
      box-shadow:
        0 0 0 1px rgba(0, 255, 65, 0.5) inset,
        0 0 0 2px rgba(0, 0, 0, 0.8),
        0 20px 60px rgba(0, 255, 65, 0.35),
        0 40px 100px rgba(0, 0, 0, 0.5);
    }
  }
  @keyframes scanTop {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  .hero-content {
    display: grid;
    gap: 1.5rem;
    max-width: 65ch;
    position: relative;
    z-index: 2;
  }
  .hero-content h1 {
    animation: fadeInUp 0.8s ease-out 0.2s both;
  }
  .eyebrow {
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: #00d9ff;
    font-weight: 800;
    background: rgba(0, 0, 0, 0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    border-radius: 0;
    width: fit-content;
    border: 2px solid rgba(0, 217, 255, 0.6);
    border-left: 4px solid #00ff41;
    box-shadow:
      0 0 10px rgba(0, 217, 255, 0.4),
      inset 0 0 10px rgba(0, 217, 255, 0.1);
    animation: fadeInUp 0.6s ease-out both;
    position: relative;
    clip-path: polygon(
      0 0,
      calc(100% - 8px) 0,
      100% 8px,
      100% 100%,
      8px 100%,
      0 calc(100% - 8px)
    );
    font-family: var(--font-mono);
  }
  .eyebrow::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 217, 255, 0.8),
      transparent
    );
    transform: translateX(-100%);
    animation: eyebrowScan 2s ease-in-out infinite;
  }
  .lede {
    font-size: 1.15rem;
    line-height: 1.7;
    max-width: 60ch;
    animation: fadeInUp 0.8s ease-out 0.4s both;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes eyebrowScan {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
    animation: fadeInUp 1s ease-out 0.6s both;
  }
  .cta,
  .ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    border-radius: 0;
    font-weight: 700;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.9rem;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    clip-path: polygon(
      0 0,
      calc(100% - 10px) 0,
      100% 10px,
      100% 100%,
      10px 100%,
      0 calc(100% - 10px)
    );
  }
  .cta {
    background: linear-gradient(135deg, #00d9ff, #00ff41);
    color: #000;
    font-weight: 800;
    box-shadow:
      0 0 20px rgba(0, 217, 255, 0.5),
      0 0 40px rgba(0, 255, 65, 0.3);
    border: 2px solid rgba(0, 217, 255, 0.8);
  }
  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.4), transparent);
    transform: translateX(-100%) skewX(-25deg);
    transition: transform 0.5s ease;
  }
  .cta::after {
    content: "";
    position: absolute;
    inset: -4px;
    background: linear-gradient(135deg, #00d9ff, #00ff41);
    z-index: -1;
    opacity: 0;
    transition: opacity 0.3s ease;
    filter: blur(12px);
  }
  .ghost {
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(0, 217, 255, 0.6);
    color: #00d9ff;
    position: relative;
  }
  .ghost::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #00d9ff, #00ff41);
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }
  .cta:hover,
  .ghost:hover {
    transform: translateY(-4px);
  }
  .cta:hover {
    box-shadow:
      0 0 30px rgba(0, 217, 255, 0.8),
      0 0 60px rgba(0, 255, 65, 0.5);
  }
  .cta:hover::before {
    transform: translateX(100%) skewX(-25deg);
  }
  .cta:hover::after {
    opacity: 1;
  }
  .ghost:hover {
    color: #000;
    border-color: #00ff41;
  }
  .ghost:hover::before {
    opacity: 1;
  }
  .cta:active,
  .ghost:active {
    transform: translateY(-2px);
  }
  .hero-visual {
    position: relative;
    min-height: clamp(260px, 32vw, 360px);
    display: grid;
    place-items: center;
    perspective: 1000px;
  }

  /* Visual Toggle Button (Mobile) */
  .visual-toggle {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 10;
    width: 44px;
    height: 44px;
    background: rgba(0, 0, 0, 0.6);
    border: 2px solid rgba(0, 217, 255, 0.6);
    clip-path: polygon(
      0 0,
      calc(100% - 8px) 0,
      100% 8px,
      100% 100%,
      8px 100%,
      0 calc(100% - 8px)
    );
    color: #00d9ff;
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.5);
  }

  .visual-toggle:hover {
    background: rgba(0, 217, 255, 0.2);
    border-color: #00ff41;
    color: #00ff41;
    box-shadow: 0 0 30px rgba(0, 255, 65, 0.6);
  }

  .visual-toggle:active {
    transform: scale(0.95);
  }

  @media (max-width: 960px) {
    .visual-toggle {
      display: flex;
    }
  }

  /* Tech Grid */
  .tech-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Hexagon Grid */
  .hex-grid {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hexagon {
    position: absolute;
    width: 60px;
    height: 60px;
    clip-path: polygon(50% 0%, 100% 25%, 100% 75%, 50% 100%, 0% 75%, 0% 25%);
    border: 2px solid rgba(0, 217, 255, 0.4);
    background: rgba(0, 217, 255, 0.05);
    animation: hexFloat 4s ease-in-out infinite;
  }

  .hex-1 {
    top: 20%;
    left: 30%;
    animation-delay: 0s;
    border-color: #00d9ff;
    box-shadow: 0 0 20px rgba(0, 217, 255, 0.4);
  }

  .hex-2 {
    top: 60%;
    left: 25%;
    width: 80px;
    height: 80px;
    animation-delay: 0.5s;
    border-color: #00ff41;
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.4);
  }

  .hex-3 {
    top: 30%;
    right: 20%;
    width: 50px;
    height: 50px;
    animation-delay: 1s;
    border-color: #00d9ff;
  }

  .hex-4 {
    bottom: 25%;
    right: 30%;
    animation-delay: 1.5s;
    border-color: #00ff41;
  }

  .hex-5 {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100px;
    height: 100px;
    animation-delay: 2s;
    border-color: #00d9ff;
    box-shadow: 0 0 30px rgba(0, 217, 255, 0.5);
  }

  .hex-6 {
    top: 15%;
    left: 60%;
    width: 70px;
    height: 70px;
    animation-delay: 2.5s;
    border-color: #00ff41;
  }

  @keyframes hexFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.4;
    }
    50% {
      transform: translateY(-20px) rotate(180deg);
      opacity: 0.8;
    }
  }

  /* Circuit Lines */
  .circuit-lines {
    position: absolute;
    inset: 0;
  }

  .circuit-line {
    position: absolute;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 217, 255, 0.6),
      transparent
    );
    animation: circuitPulse 3s ease-in-out infinite;
  }

  .line-1 {
    width: 2px;
    height: 50%;
    top: 25%;
    left: 35%;
    animation-delay: 0s;
  }

  .line-2 {
    width: 60%;
    height: 2px;
    top: 40%;
    left: 20%;
    animation-delay: 0.75s;
  }

  .line-3 {
    width: 2px;
    height: 60%;
    top: 20%;
    right: 30%;
    animation-delay: 1.5s;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 255, 65, 0.6),
      transparent
    );
  }

  .line-4 {
    width: 50%;
    height: 2px;
    bottom: 30%;
    right: 25%;
    animation-delay: 2.25s;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 255, 65, 0.6),
      transparent
    );
  }

  @keyframes circuitPulse {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }

  /* Geometric Shapes */
  .geometric-shapes {
    position: absolute;
    inset: 0;
  }

  .triangle,
  .square {
    position: absolute;
    animation: shapeFloat 5s ease-in-out infinite;
  }

  .triangle {
    width: 0;
    height: 0;
    border-left: 20px solid transparent;
    border-right: 20px solid transparent;
    border-bottom: 35px solid rgba(0, 217, 255, 0.4);
  }

  .tri-1 {
    top: 25%;
    left: 20%;
    animation-delay: 0s;
  }

  .tri-2 {
    bottom: 30%;
    left: 35%;
    animation-delay: 1s;
    border-bottom-color: rgba(0, 255, 65, 0.4);
  }

  .tri-3 {
    top: 35%;
    right: 25%;
    animation-delay: 2s;
  }

  .square {
    width: 30px;
    height: 30px;
    border: 2px solid rgba(0, 217, 255, 0.4);
    background: rgba(0, 217, 255, 0.05);
  }

  .sq-1 {
    top: 50%;
    left: 25%;
    animation-delay: 0.5s;
  }

  .sq-2 {
    bottom: 25%;
    right: 30%;
    animation-delay: 1.5s;
    border-color: rgba(0, 255, 65, 0.4);
    background: rgba(0, 255, 65, 0.05);
  }

  @keyframes shapeFloat {
    0%,
    100% {
      transform: translateY(0) rotate(0deg);
      opacity: 0.4;
    }
    50% {
      transform: translateY(-15px) rotate(90deg);
      opacity: 0.7;
    }
  }

  /* Sharp Beams */
  .sharp-beams {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .beam {
    position: absolute;
    width: 2px;
    height: 200px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(0, 217, 255, 0.8),
      transparent
    );
    box-shadow: 0 0 10px rgba(0, 217, 255, 0.8);
    animation: beamSweep 4s linear infinite;
  }

  .beam-1 {
    left: 30%;
    animation-delay: 0s;
  }

  .beam-2 {
    left: 50%;
    animation-delay: 1.3s;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(0, 255, 65, 0.8),
      transparent
    );
    box-shadow: 0 0 10px rgba(0, 255, 65, 0.8);
  }

  .beam-3 {
    left: 70%;
    animation-delay: 2.6s;
  }

  @keyframes beamSweep {
    0% {
      transform: translateY(-200px);
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
    100% {
      transform: translateY(calc(100% + 200px));
      opacity: 0;
    }
  }

  /* Grid Overlay */
  .grid-overlay {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
        rgba(0, 217, 255, 0.1) 1px,
        transparent 1px
      ),
      linear-gradient(90deg, rgba(0, 217, 255, 0.1) 1px, transparent 1px);
    background-size: 40px 40px;
    mask: radial-gradient(
      circle at center,
      rgba(255, 255, 255, 0.5),
      rgba(255, 255, 255, 0) 70%
    );
    opacity: 0.4;
    animation: gridPulse 8s ease-in-out infinite;
  }

  @keyframes gridPulse {
    0%,
    100% {
      opacity: 0.4;
    }
    50% {
      opacity: 0.6;
    }
  }

  /* Scan Line */
  .scan-line {
    position: absolute;
    width: 100%;
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(0, 217, 255, 0.8),
      transparent
    );
    box-shadow: 0 0 10px rgba(0, 217, 255, 0.8);
    animation: scanSweep 5s linear infinite;
    top: 0;
  }

  @keyframes scanSweep {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      transform: translateY(360px);
      opacity: 0;
    }
